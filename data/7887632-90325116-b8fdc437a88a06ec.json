ass=\"plainlist\"><ul><li><a href=\"/wiki/%E5%8A%A0%E5%B7%9E%E7%90%86%E5%B7%A5%E5%AD%B8%E9%99%A2\" title=\"加州理工學院\">加州理工學院</a></li><li><a href=\"/wiki/%E8%80%B6%E9%B2%81%E5%A4%A7%E5%AD%A6\" title=\"耶魯大學\">耶魯大學</a>&#160;<span class=\"mw-valign-text-top\" typeof=\"mw:File/Frameless\"><a href=\"https://www.wikidata.org/wiki/Q745396?uselang=zh-tw#P69\" title=\"編輯維基數據\"><img alt=\"編輯維基數據\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></li></ul></div></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">職業</th><td class=\"infobox-data role\" style=\"\"><a href=\"/wiki/%E4%BD%9C%E5%AE%B6\" title=\"作家\">作家</a>&#160;<span class=\"mw-valign-text-top\" typeof=\"mw:File/Frameless\"><a href=\"https://www.wikidata.org/wiki/Q745396?uselang=zh-tw#P106\" title=\"編輯維基數據\"><img alt=\"編輯維基數據\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">作品</th><td class=\"infobox-data\" style=\"\">食物和烹飪&#160;<span class=\"mw-valign-text-top\" typeof=\"mw:File/Frameless\"><a href=\"https://www.wikidata.org/wiki/Q745396?uselang=zh-tw#P800\" title=\"編輯維基數據\"><img alt=\"編輯維基數據\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">配偶</th><td class=\"infobox-data\" style=\"\"><span itemscope=\"\" itemtype=\"https&#58;//zh.wikipedia.org/wiki/哈洛德·马基\"><span itemprop=\"spouse\"><a href=\"/wiki/%E8%8E%8E%E4%BC%A6%C2%B7R%C2%B7%E6%9C%97\" title=\"莎倫·R·朗\">莎倫·R·朗</a><br /></span>（<style data-mw-deduplicate=\"TemplateStyles:r79005747\">.mw-parser-output .tooltip-dotted{border-bottom:1px dotted;cursor:help}</style><span class=\"rt-commentedText tooltip\" title=\"1979年7月7日\">1979年</span>結婚—<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r79005747\" /><span class=\"rt-commentedText tooltip\" title=\"2004年\">2004年</span>離婚）</span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">獎項</th><td class=\"infobox-data\" style=\"\">向公眾闡釋化學之詹姆斯獎&#160;<span class=\"mw-valign-text-top\" typeof=\"mw:File/Frameless\"><a href=\"https://www.wikidata.org/wiki/Q745396?uselang=zh-tw#P166\" title=\"編輯維基數據\"><img alt=\"編輯維基數據\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">網站</th><td class=\"infobox-data\" style=\"\"><a rel=\"nofollow\" class=\"external free\" href=\"https://haroldmcgee.substack.com\">https://haroldmcgee.substack.com</a>&#160;<span class=\"mw-valign-text-top\" typeof=\"mw:File/Frameless\"><a href=\"https://www.wikidata.org/wiki/Q745396?uselang=zh-tw#P856\" title=\"編輯維基數據\"><img alt=\"編輯維基數據\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr></tbody></table>\n<p><b>哈洛德·馬基</b>（英語：<span lang=\"en\">Harold McGee</span>，1951年10月3日—）是一位<a href=\"/wiki/%E7%BE%8E%E5%9B%BD\" title=\"美國\">美國</a><a href=\"/wiki/%E4%BD%9C%E5%AE%B6\" title=\"作家\">作家</a>和<a href=\"/wiki/%E9%A3%9F%E5%93%81%E7%A7%91%E5%AD%B8\" title=\"食品科學\">食品科學</a>與<a href=\"/wiki/%E7%83%B9%E9%A5%AA\" title=\"烹飪\">烹飪</a>的<a href=\"/wiki/%E5%8C%96%E5%AD%A6\" class=\"mw-redirect\" title=\"化學\">化學</a>與<a href=\"/wiki/%E5%8E%86%E5%8F%B2%E5%AD%A6%E5%AE%B6\" title=\"歷史學家\">歷史學家</a>，1978年畢業於<a href=\"/wiki/%E8%80%B6%E9%B2%81%E5%A4%A7%E5%AD%A6\" title=\"耶魯大學\">耶魯大學</a>，導師<a href=\"/wiki/%E5%93%88%E7%BE%85%E5%BE%B7%C2%B7%E5%B8%83%E9%AD%AF%E5%A7%86\" class=\"mw-redirect\" title=\"哈羅德·布魯姆\">哈羅德·布魯姆</a><sup id=\"cite&#95;ref-phd&#95;1-0\" class=\"reference\"><a href=\"#cite_note-phd-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>，主要作品有《<span class=\"ilh-all\" data-orig-title=\"食物与厨艺\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"On Food and Cooking\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E9%A3%9F%E7%89%A9%E4%B8%8E%E5%8E%A8%E8%89%BA&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"食物與廚藝（頁面不存在）\">食物與廚藝</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/On_Food_and_Cooking\" class=\"extiw\" title=\"en:On Food and Cooking\"><span lang=\"en\" dir=\"auto\">On Food and Cooking</span></a></span><span class=\"ilh-paren\">）</span></span></span>》（<i>On Food and Cooking: The Science and Lore of the Kitchen</i>，1984年初版<sup id=\"cite&#95;ref-ofac&#95;2-0\" class=\"reference\"><a href=\"#cite_note-ofac-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>，2004年再版<sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-eggwhites&#95;5-0\" class=\"reference\"><a href=\"#cite_note-eggwhites-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-curious&#95;6-0\" class=\"reference\"><a href=\"#cite_note-curious-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup>）等。\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"参考文献\"><span id=\".E5.8F.82.E8.80.83.E6.96.87.E7.8C.AE\"></span>參考文獻</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%93%88%E6%B4%9B%E5%BE%B7%C2%B7%E9%A9%AC%E5%9F%BA&amp;action=edit&amp;section=1\" title=\"編輯章節：參考文獻\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r95310437\">.mw-parser-output .reflist{margin-bottom:0.5em;list-style-type:decimal}@media screen{.mw-parser-output .reflist{font-size:90%}}.mw-parser-output .reflist .references{font-size:100%;margin-bottom:0;list-style-type:inherit}.mw-parser-output .reflist-columns{margin-top:0.3em}.mw-parser-output .reflist-columns ol{margin-top:0}.mw-parser-output .reflist-columns li{page-break-inside:avoid;break-inside:avoid-column}.mw-parser-output .reflist-upper-alpha{list-style-type:upper-alpha}.mw-parser-output .reflist-upper-roman{li