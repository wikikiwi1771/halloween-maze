%B6%D0%B5%D1%82_%D0%B2%D1%8B%D0%BF%D0%BE%D0%BB%D0%BD%D0%B8%D1%82%D1%8C_%D0%BF%D0%BB%D0%B0%D0%BD_%D0%B2%D1%82%D0%BE%D1%80%D0%BE%D0%B9_%D0%B1%D0%BE%D0%BB%D1%8C%D1%88%D0%B5%D0%B2%D0%B8%D1%81%D1%82%D1%81%D0%BA%D0%BE%D0%B9_%D0%B2%D0%B5%D1%81%D0%BD%D1%8B.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2945\" data-file-height=\"4000\" /></a><figcaption>1931年的宣傳海報：「集體農莊的莊員們，讀讀這本書！這本書將有助於實現布爾什維克第二個春天的計劃！」</figcaption></figure>\n<figure class=\"mw-default-size\" typeof=\"mw:File/Thumb\"><a href=\"/wiki/File:%D0%91%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D0%B8%D1%80_%D1%85%D0%BB%D0%BE%D0%BF%D0%BA%D0%BE%D0%B2%D0%BE%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B9_%D0%B1%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D1%8B_%D0%BA%D0%BE%D0%BB%D1%85%D0%BE%D0%B7%D0%B0_%D0%97%D0%B0%D1%80%D1%8F_%D0%92%D0%BE%D1%81%D1%82%D0%BE%D0%BA%D0%B0_%D0%A7%D0%B5%D1%87%D0%B5%D0%BD%D0%BE-%D0%98%D0%BD%D0%B3%D1%83%D1%88%D0%B5%D1%82%D0%B8%D1%8F.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/%D0%91%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D0%B8%D1%80_%D1%85%D0%BB%D0%BE%D0%BF%D0%BA%D0%BE%D0%B2%D0%BE%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B9_%D0%B1%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D1%8B_%D0%BA%D0%BE%D0%BB%D1%85%D0%BE%D0%B7%D0%B0_%D0%97%D0%B0%D1%80%D1%8F_%D0%92%D0%BE%D1%81%D1%82%D0%BE%D0%BA%D0%B0_%D0%A7%D0%B5%D1%87%D0%B5%D0%BD%D0%BE-%D0%98%D0%BD%D0%B3%D1%83%D1%88%D0%B5%D1%82%D0%B8%D1%8F.jpg/250px-%D0%91%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D0%B8%D1%80_%D1%85%D0%BB%D0%BE%D0%BF%D0%BA%D0%BE%D0%B2%D0%BE%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B9_%D0%B1%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D1%8B_%D0%BA%D0%BE%D0%BB%D1%85%D0%BE%D0%B7%D0%B0_%D0%97%D0%B0%D1%80%D1%8F_%D0%92%D0%BE%D1%81%D1%82%D0%BE%D0%BA%D0%B0_%D0%A7%D0%B5%D1%87%D0%B5%D0%BD%D0%BE-%D0%98%D0%BD%D0%B3%D1%83%D1%88%D0%B5%D1%82%D0%B8%D1%8F.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"183\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/4/4e/%D0%91%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D0%B8%D1%80_%D1%85%D0%BB%D0%BE%D0%BF%D0%BA%D0%BE%D0%B2%D0%BE%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B9_%D0%B1%D1%80%D0%B8%D0%B3%D0%B0%D0%B4%D1%8B_%D0%BA%D0%BE%D0%BB%D1%85%D0%BE%D0%B7%D0%B0_%D0%97%D0%B0%D1%80%D1%8F_%D0%92%D0%BE%D1%81%D1%82%D0%BE%D0%BA%D0%B0_%D0%A7%D0%B5%D1%87%D0%B5%D0%BD%D0%BE-%D0%98%D0%BD%D0%B3%D1%83%D1%88%D0%B5%D1%82%D0%B8%D1%8F.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\" data-file-width=\"455\" data-file-height=\"333\" /></a><figcaption><a href=\"/wiki/%E8%BB%8A%E8%87%A3-%E5%8D%B0%E5%8F%A4%E4%BB%80%E8%98%87%E7%B6%AD%E5%9F%83%E7%A4%BE%E6%9C%83%E4%B8%BB%E7%BE%A9%E8%87%AA%E6%B2%BB%E5%85%B1%E5%92%8C%E5%9C%8B\" title=\"車臣-印古什蘇維埃社會主義自治共和國\">車臣-印古什蘇維埃社會主義自治共和國</a>一間集體農莊中的<a href=\"/wiki/%E6%A3%89%E8%8A%B1\" title=\"棉花\">棉花</a>種植者，攝於1938年</figcaption></figure>\n<p><b>集體農莊</b>（俄語：<span lang=\"ru\">колхоз</span>，<style data-mw-deduplicate=\"TemplateStyles:r88674605\">.mw-parser-output .IPA-label-small{font-size:85%}.mw-parser-output .references .IPA-label-small,.mw-parser-output .infobox .IPA-label-small,.mw-parser-output .navbox .IPA-label-small{font-size:100%}</style><span class=\"IPA-label IPA-label-small\">國際音標：</span><span class=\"IPA nowrap\" lang=\"ru-Latn-fonipa\"><a href=\"/wiki/Help:%E4%BF%84%E8%AA%9E%E5%9C%8B%E9%9A%9B%E9%9F%B3%E6%A8%99\" title=\"Help:俄語國際音標\">&#91;kɐlˈxos&#93;</a></span> <span class=\"unicode haudio\"><span class=\"fn\"><span class=\"ext-phonos\"><span data-nosnippet=\"\" id=\"ooui-php-1\" class=\"noexcerpt ext-phonos-PhonosButton ext-phonos-PhonosButton-emptylabel oo-ui-widget oo-ui-widget-enabled oo-ui-buttonElement oo-ui-buttonElement-frameless oo-ui-buttonElement-size-medium oo-ui-iconElement oo-ui-buttonWidget\" data-ooui=\"{&quot;_&quot;:&quot;mw.Phonos.PhonosButton&quot;,&quot;href&quot;:&quot;\\/\\/upload.wikimedia.org\\/wikipedia\\/commons\\/transcoded\\/3\\/35\\/Ru-kolkhoz.ogg\\/Ru-kolkhoz.ogg.mp3&quot;,&quot;rel&quot;:[&quot;nofollow&quot;],&quot;framed&quot;:false,&quot;icon&quot;:&quot;volumeUp&quot;,&quot;data&quot;:{&quot;ipa&quot;:&quot;&quot;,&quot;text&quot;:&quot;&quot;,&quot;lang&quot;:&quot;zh&quot;,&quot;wikibase&quot;:&quot;&quot;,&quot;file&quot;:&quot;Ru-kolkhoz.ogg&quot;},&quot;classes&quot;:[&quot;noexcerpt&quot;,&quot;ext-phonos-PhonosButton&quot;,&quot;ext-phonos-PhonosButton-emptylabel&quot;]}\"><a role=\"button\" tabindex=\"0\" href=\"//upload.wikimedia.org/wikipedia/commons/transcoded/3/35/Ru-kolkhoz.ogg/Ru-kolkhoz.ogg.mp3\" rel=\"nofollow\" aria-label=\"播放音訊\" title=\"播放音訊\" class=\"oo-ui-buttonElement-button\"><span class=\"oo-ui-iconElement-icon oo-ui-icon-volumeUp\"></span><span class=\"oo-ui-labelElement-label\"></span><span class=\"oo-ui-indicatorElement-indicator oo-ui-indicatorElement-noIndicator\"></span></a></span><sup class=\"ext-phonos-attribution noexcerpt navigation-not-searchable\"><a href=\"/wiki/File:Ru-kolkhoz.ogg\" title=\"File:Ru-kolkhoz.ogg\">ⓘ</a></sup></span></span></span>）是<a href=\"/wiki/%E8%8B%8F%E8%81%94\" title=\"蘇聯\">蘇聯</a>的一種<a href=\"/wiki/%E9%9B%86%E4%BD%93%E8%80%95%E4%BD%9C\" title=\"集體耕作\">集體農場</a>，蘇聯集體農莊和<a href=\"/wiki/%E5%9C%8B%E7%87%9F%E8%BE%B2%E5%A0%B4\" title=\"國營農場\">國營農場</a>（俄語：<span lang=\"ru\">совхоз</span>）都是在1917年<a href=\"/wiki/%E5%8D%81%E6%9C%88%E9%9D%A9%E5%91%BD\" title=\"十月革命\">十月革命</a>後出現的<a href=\"/wiki/%E8%98%87%E8%81%AF%E8%BE%B2%E6%A5%AD\" title=\"蘇聯農業\">蘇聯農業</a>形式，蘇聯集體農莊及國營農場。\n</p><p>1920年代在巡迴的宣傳者影響之下，開始出許多自發性的集體農場。一開始的集體農場是傳統俄羅斯<a href=\"/wiki/%E6%9D%91%E7%A4%BE_(%E7%A4%BE%E6%9C%83%E5%88%B6%E5%BA%A6)\" class=\"mw-disambig\" title=\"村社 (社會制度)\">村社</a>的現代版，廣泛的「農業組織」（zemledel' cheskaya artel），<span class=\"ilh-all\" data-orig-title=\"土地聯合耕地協會\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Association for Joint Cultivation of Land\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E5%9C%9F%E5%9C%B0%E8%81%AF%E5%90%88%E8%80%95%E5%9C%B0%E5%8D%94%E6%9C%83&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"土地聯合耕地協會（頁面不存在）\">土地聯合耕地協會</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Association_for_Joint_Cultivation_of_Land\" class=\"extiw\" title=\"en:Association for Joint Cultivation of Land\"><span lang=\"en\" dir=\"auto\">Association for Joint Cultivation of Land</span></a></span><span class=\"ilh-paren\">）</span></span></span>（簡稱TOZ），最後才形成蘇聯集體農莊。十月革命後前十五年的農業漸漸變成集體農莊，而在1928年開始的<a href=\"/wiki/%E8%8B%8F%E8%81%94%E5%86%9C%E4%B8%9A%E9%9B%86%E4%BD%93%E5%8C%96\" title=\"蘇聯農業集體化\">蘇聯農業集體化</a>運動中演變成「暴力衝突」。\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"相關條目\"><span id=\".E7.9B.B8.E9.97.9C.E6.A2.9D.E7.9B.AE\"></span>相關條目</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%8B%8F%E8%81%94%E9%9B%86%E4%BD%93%E5%86%9C%E5%BA%84&amp;action=edit&amp;section=1\" title=\"編輯章節：相關條目\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/%E9%9B%86%E4%BD%93%E8%80%95%E4%BD%9C\" title=\"集體耕作\">集體耕作</a></li>\n<li><span class=\"ilh-all\" data-orig-title=\"Zveno\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Zveno (Soviet collective farming)\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=Zveno&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Zveno（頁面不存在）\">Zveno</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Zveno_(Soviet_collective_farming)\" class=\"extiw\" title=\"en:Zveno (Soviet collective farming)\"><span lang=\"en\" dir=\"auto\">Zveno (Soviet collective farming)</span></a></span><span class=\"ilh-paren\">）</span></span></span></li>\n<li><a hre