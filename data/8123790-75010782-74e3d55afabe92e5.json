{"schema":1,"revision":75010782,"page":{"pageid":8123790,"title":"节肢动物学","displayTitle":"節肢動物學","variant":"zh-tw"},"html":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"zh-Hant-TW\" dir=\"ltr\"><table class=\"toccolours\" cellpadding=\"1\" width=\"180px\" style=\"float: right; margin: 0 0 0.5em 1em; text-align:center; border: 1px solid #80FFC9; font-size: 90%;clear:right;\">\n<tbody><tr>\n<td><small>動物學系列</small>\n<p><span style=\"font-size: 130%\"><b><a href=\"/wiki/%E5%8A%A8%E7%89%A9%E5%AD%A6\" title=\"動物學\">動物學</a></b></span><br />\n<span typeof=\"mw:File\"><a href=\"/wiki/File:Animal_diversity.png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Animal_diversity.png/250px-Animal_diversity.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"366\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/1/14/Animal_diversity.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\" data-file-width=\"354\" data-file-height=\"518\" /></a></span>\n<br />\n</p>\n</td></tr>\n<tr>\n<td style=\"color:#ffff; background-color:#007D48;\"><b><span style=\"color: white;\">動物學分支</span></b>\n</td></tr>\n<tr>\n<td style=\"font-size: 90%\">\n<p><a href=\"/wiki/%E4%BA%BA%E7%B1%BB%E5%AD%A6\" title=\"人類學\">人類學</a> · <a href=\"/wiki/%E4%BA%BA%E8%88%87%E5%8B%95%E7%89%A9%E9%97%9C%E4%BF%82%E5%AD%B8\" title=\"人與動物關係學\">人與動物關係學</a><br />\n<a href=\"/wiki/%E8%9C%9C%E8%9C%82%E5%AD%B8\" class=\"mw-redirect\" title=\"蜜蜂學\">蜜蜂學</a> · <a class=\"mw-selflink selflink\">節肢動物學</a><br />\n<a href=\"/w/index.php?title=%E5%8C%BB%E5%AD%A6%E8%8A%82%E8%82%A2%E5%8A%A8%E7%89%A9%E5%AD%A6&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"醫學節肢動物學（頁面不存在）\">醫學節肢動物學</a> · <a href=\"/wiki/%E9%AF%A8%E9%A1%9E%E5%AD%B8\" title=\"鯨類學\">鯨類學</a><br />\n<a href=\"/wiki/%E8%B2%9D%E9%A1%9E%E5%AD%B8\" title=\"貝類學\">貝類學</