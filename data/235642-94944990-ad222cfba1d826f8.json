</style><table class=\"infobox vcard\" style=\"width:24.5em; line-height:1.5em;\"><tbody><tr><th colspan=\"2\" class=\"infobox-above fn org\" style=\"background-color: #E7DCC3;color:#000;\">劍潭山</th></tr><tr><td colspan=\"2\" class=\"infobox-image\" style=\"padding: 0.3em 0.2em 0.2em 0.2em;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Chientan_Mountain_and_Dajia_Riverside_Park.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Chientan_Mountain_and_Dajia_Riverside_Park.jpg/330px-Chientan_Mountain_and_Dajia_Riverside_Park.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"272\" height=\"204\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Chientan_Mountain_and_Dajia_Riverside_Park.jpg/960px-Chientan_Mountain_and_Dajia_Riverside_Park.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"4000\" data-file-height=\"3000\" /></a></span><div class=\"infobox-caption\" style=\"padding: 0.2em 0em;\">劍潭山遠景與<a href=\"/wiki/%E5%A4%A7%E4%BD%B3%E6%B2%B3%E6%BF%B1%E5%85%AC%E5%9C%92\" title=\"大佳河濱公園\">大佳河濱公園</a></div></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #E7DCC3;color:#000;;\">最高點</th></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"vertical-align:text-bottom; white-space: nowrap;;\"><a href=\"/wiki/%E6%B5%B7%E6%8B%94\" title=\"海拔\">海拔</a></th><td class=\"infobox-data\" style=\"\">153公尺（502英尺）</td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"vertical-align:text-bottom; white-space: nowrap;;\"><a href=\"/wiki/%E7%BB%8F%E7%BA%AC%E5%BA%A6\" class=\"mw-redirect\" title=\"經緯度\">座標</a></th><td class=\"infobox-data\" style=\"\"><span class=\"geo-inline\"><style data-mw-deduplicate=\"TemplateStyles:r82757201\">.mw-parser-output .geo-default,.mw-parser-output .geo-dms,.mw-parser-output .geo-dec{display:inline}.mw-parser-output .geo-nondefault,.mw-parser-output .geo-multi-punct,.mw-parser-output .geo-inline-hidden{display:none}.mw-parser-output .longitude,.mw-parser-output .latitude{white-space:nowrap}</style><span class=\"plainlinks nourlexpansion\"><a class=\"external text\" href=\"//geohack.toolforge.org/geohack.php?language=zh&amp;pagename=%E5%8A%8D%E6%BD%AD%E5%B1%B1&amp;params=25_05_3.4_N_121_31_45.6_E_\"><span class=\"geo-default\"><span class=\"geo-dms\" title=\"此地的地圖、航拍照片和其他數據\"><span class=\"latitude\">25°05′3.4″N</span> <span class=\"longitude\">121°31′45.6″E</span></span></span><span class=\"geo-multi-punct\">&#xfeff; / &#xfeff;</span><span class=\"geo-nondefault\"><span class=\"geo-dec\" title=\"此地的地圖、航拍照片和其他數據\">25.084278°N 121.529333°E</span><span style=\"display:none\">&#xfeff; / <span class=\"geo\">25.084278; 121.529333</span></span></span></a></span> <strong class=\"error\">坐標：參數： \"type=\" 應為 \"type:\"</strong><br /></span></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #E7DCC3;color:#000;;\">地理</th></tr><tr><td colspan=\"2\" class=\"infobox-full-data\" style=\"\"><div style=\"padding:0.2em 0.2em 0.2em 0.2em;\"><style data-mw-deduplicate=\"TemplateStyles:r66786032\">.mw-parser-output .locmap .od{position:absolute}.mw-parser-output .locmap .id{position:absolute;line-height:0}.mw-parser-output .locmap .l0{font-size:0;position:absolute}.mw-parser-output .locmap .pv{line-height:110%;position:absolute;text-align:center}.mw-parser-output .locmap .pl{line-height:110%;position:absolute;top:-0.75em;text-align:right}.mw-parser-output .locmap .pr{line-height:110%;position:absolute;top:-0.75em;text-align:left}.mw-parser-output .locmap .pv>div{display:inline;padding:1px}.mw-parser-output .locmap .pl>div{display:inline;padding:1px;float:right}.mw-parser-output .locmap .pr>div{display:inline;padding:1px;float:left}</style><div class=\"center\"><div class=\"locmap\" style=\"width:272px;float:none;clear:both;margin-left:auto;margin-right:auto\"><div style=\"width:272px;padding:0\"><div style=\"position:relative;width:272px\"><span class=\"notpageimage\" typeof=\"mw:File\"><a href=\"/wiki/File:Taiwan_relief_location_map.jpg\" class=\"mw-file-description\" title=\"劍潭山在臺灣的位置\"><img alt=\"劍潭山在臺灣的位置\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Taiwan_relief_location_map.jpg/330px-Taiwan_relief_location_map.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"272\" height=\"327\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Taiwan_relief_location_map.jpg/960px-Taiwan_relief_location_map.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1016\" data-file-height=\"1222\" /></a></span><div class=\"od notheme mw-no-invert\" style=\"top:27.994%;left:82.078%\"><div class=\"id\" style=\"left:-8px;top:-8px\"><span class=\"notpageimage\" typeof=\"mw:File\"><span title=\"劍潭山\"><img alt=\"劍潭山\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/39/Red_triangle_with_thick_white_border.svg/20px-Red_triangle_with_thick_white_border.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"14\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/39/Red_triangle_with_thick_white_border.svg/40px-Red_triangle_with_thick_white_border.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"270\" data-file-height=\"240\" /></span></span></div><div class=\"pl\" style=\"font-size:91%;width:6em;right:9px\"><div>劍潭山</div></div></div></div><div style=\"padding-top:0.2em\">劍潭山的位置</div></div></div></div>\n            </div></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"vertical-align:text-bottom; white-space: nowrap;;\">位置</th><td class=\"infobox-data label\" style=\"\"><a href=\"/wiki/%E4%B8%AD%E8%8F%AF%E6%B0%91%E5%9C%8B\" title=\"中華民國\">中華民國</a><a href=\"/wiki/%E5%8F%B0%E5%8C%97%E5%B8%82\" class=\"mw-redirect\" title=\"台北市\">台北市</a><a href=\"/wiki/%E5%A3%AB%E6%9E%97%E5%8D%80\" title=\"士林區\">士林區</a>、<a href=\"/wiki/%E4%B8%AD%E5%B1%B1%E5%8D%80_(%E8%87%BA%E5%8C%97%E5%B8%82)\" title=\"中山區 (臺北市)\">中山區</a></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"vertical-align:text-bottom; white-space: nowrap;;\">所屬山脈</th><td class=\"infobox-data category\" style=\"\"><a href=\"/wiki/%E5%8A%A0%E9%87%8C%E5%B1%B1%E5%B1%B1%E8%84%88\" title=\"加里山山脈\">加里山山脈</a>之<a href=\"/wiki/%E4%BA%94%E6%8C%87%E5%B1%B1%E5%B1%B1%E8%84%88\" title=\"五指山山脈\">五指山山脈</a></td></tr></tbody></table>\n<p><b>劍潭山</b>位於<a href=\"/wiki/%E5%8F%B0%E7%81%A3\" class=\"mw-redirect\" title=\"台灣\">台灣</a><a href=\"/wiki/%E5%8F%B0%E5%8C%97%E5%B8%82\" class=\"mw-redirect\" title=\"台北市\">台北市</a><a href=\"/wiki/%E5%A3%AB%E6%9E%97%E5%8D%80\" title=\"士林區\">士林區</a>及<a href=\"/wiki/%E4%B8%AD%E5%B1%B1%E5%8D%80_(%E8%87%BA%E5%8C%97%E5%B8%82)\" title=\"中山區 (臺北市)\">中山區</a>，為<a href=\"/wiki/%E4%BA%94%E6%8C%87%E5%B1%B1%E5%B1%B1%E8%84%88\" title=\"五指山山脈\">五指山山脈</a>主稜最西側之小山丘，<a href=\"/wiki/%E7%A8%9C%E7%B7%9A\" class=\"mw-redirect\" title=\"稜線\">稜線</a>轉南經<a href=\"/wiki/%E5%9C%93%E5%B1%B1%E9%A3%AF%E5%BA%97\" class=\"mw-redirect\" title=\"圓山飯店\">圓山飯店</a>後沒入<a href=\"/wiki/%E5%9F%BA%E9%9A%86%E6%B2%B3\" title=\"基隆河\">基隆河</a><sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>。地質為<a href=\"/wiki/%E6%9C%A8%E5%B1%B1%E5%B1%A4\" title=\"木山層\">木山層</a>，主要由<a href=\"/wiki/%E7%A0%82%E5%B2%A9\" title=\"砂岩\">砂岩</a>、<a href=\"/wiki/%E9%A1%B5%E5%B2%A9\" title=\"頁岩\">頁岩</a>互層所組成<sup id=\"cite&#95;ref-:1&#95;2-0\" class=\"reference\"><a href=\"#cite_note-:1-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>。標高153公尺，連其山麓緩坡蔓延約2.7公里，山頂有二等三角點基石，編號1064，為<a href=\"/wiki/%E5%8F%B0%E7%81%A3%E5%B0%8F%E7%99%BE%E5%B2%B3\" title=\"台灣小百岳\">台灣小百岳</a>之一。該山因為臨<a href=\"/wiki/%E5%8A%8D%E6%BD%AD\" title=\"劍潭\">劍潭</a>，故以劍潭山為名。該山區域約在台北圓山與士林街道之間。2007年，<a href=\"/wiki/%E5%8F%B0%E5%8C%97%E5%B8%82%E6%94%BF%E5%BA%9C\" class=\"mw-redirect\" title=\"台北市政府\">台北市政府</a>在劍潭山設置<a href=\"/wiki/%E8%A6%AA%E5%B1%B1%E6%AD%A5%E9%81%93\" title=\"親山步道\">親山步道</a>。\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"地名\"><span id=\".E5.9C.B0.E5.90.8D\"></span>地名</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%8A%8D%E6%BD%AD%E5%B1%B1&amp;action=edit&amp;section=1\" title=\"編輯章節：地名\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>劍潭此地名，與17世紀的漢人附會的「<a href=\"/wiki/%E9%84%AD%E6%88%90%E5%8A%9F#傳說\" title=\"鄭成功\">鄭成功民間傳說</a>」有關。相傳1660年代，鄭成功及軍隊行經此河河段時，遇見神怪與神怪造成的大風浪，為伏怪，鄭成功拋一身邊寶劍，始降服神怪。後人為紀念此事件，故將該河段與所涵蓋流域皆以劍潭命名。現實中，<a href=\"/wiki/%E5%9C%8B%E5%A7%93%E7%88%BA\" class=\"mw-redirect\" title=\"國姓爺\">國姓爺</a><a href=\"/wiki/%E9%84%AD%E6%88%90%E5%8A%9F\" title=\"鄭成功\">鄭成功</a>行跡並未觸及<a href=\"/wiki/%E6%9D%B1%E9%83%BD%E6%98%8E%E4%BA%AC\" class=\"mw-redirect\" title=\"東都明京\">東都明京</a>以外區域。\n</p><p>惟因1950年代後，設於該地許多建物或景點皆以圓山命名，如<a href=\"/wiki/%E5%9C%93%E5%B1%B1%E5%A4%A7%E9%A3%AF%E5%BA%97\" title=\"圓山大飯店\">圓山大飯店</a>、<a href=\"/wiki/%E5%9C%93%E5%B1%B1%E8%82%B2%E6%A8%82%E4%B8%AD%E5%BF%83\" class=\"mw-redirect\" title=\"圓山育樂中心\">圓山育樂中心</a>（<a href=\"/wiki/%E5%9C%93%E5%B1%B1%E4%BF%9D%E9%BD%A1%E7%90%83%E9%A4%A8\" title=\"圓山保齡球館\">圓山保齡球館</a>）、<a href=\"/w/index.php?title=%E5%9C%93%E5%B1%B1%E9%A2%A8%E6%99%AF%E5%8D%80&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"圓山風景區（頁面不存在）\">圓山風景區</a>等等，近年一般訪客多把劍潭山與圓山在名稱與範圍上多為搞混與併用。\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"概述\"><span id=\".E6.A6.82.E8.BF.B0\"></span>概述</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%8A%8D%E6%BD%AD%E5%B1%B1&amp;action=edit&amp;section=2\" title=\"編輯章節：概述\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>劍潭山區域十分寬廣，其路徑高達2.7公里。清乾隆三十八年（1773年），劍潭山南麓即建有<a href=\"/wiki/%E5%8A%8D%E6%BD%AD%E5%AF%BA\" class=\"mw-redirect\" title=\"劍潭寺\">劍潭寺</a>，劍潭幻影也是<a href=\"/wiki/%E6%B7%A1%E6%B0%B4%E5%BB%B3\" title=\"淡水廳\">淡水廳</a>八景之一<sup id=\"cite&#95;ref-:1&#95;2-1\" class=\"reference\"><a href=\"#cite_note-:1-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>。在日治時期，山麓一帶陸續興建<a href=\"/wiki/%E8%87%BA%E7%81%A3%E7%A5%9E%E7%A4%BE\" class=\"mw-redirect\" title=\"臺灣神社\">臺灣神社</a>、<a href=\"/wiki/%E5%A3%AB%E6%9E%97%E5%AE%98%E9%82%B8\" title=\"士林官邸\">士林園藝試驗支所</a>、<a href=\"/wiki/%E8%87%BA%E5%8C%97%E5%B8%9D%E5%9C%8B%E5%A4%A7%E5%AD%B8%E7%86%B1%E5%B8%B6%E9%86%AB%E5%AD%B8%E7%A0%94%E7%A9%B6%E6%89%80\" title=\"臺北帝國大學熱帶醫學研究所\">熱帶醫學研究所士林支所</a>、<a href=\"/wiki/%E5%9C%93%E5%B1%B1%E6%B0%B4%E7%A5%9E%E7%A4%BE\" class=\"mw-redirect\" title=\"圓山水神社\">圓山水神社</a>、<a href=\"/wiki/%E5%9C%8B%E6%B0%91%E7%B2%BE%E7%A5%9E%E7%A0%94%E4%BF%AE%E6%89%80\" title=\"國民精神研修所\">國民精神研修所</a>、<a href=\"/wiki/%E8%87%BA%E7%81%A3%E8%AD%B7%E5%9C%8B%E7%A5%9E%E7%A4%BE\" title=\"臺灣護國神社\">臺灣護國神社</a>等設施。二戰後，劍潭山因地理位置重要，被劃為軍事管制區，直到1987年<a href=\"/wiki/%E8%87%BA%E7%81%A3%E8%A7%A3%E5%9A%B4\" class=\"mw-redirect\" title=\"臺灣解嚴\">臺灣解嚴</a>後才逐步對外開放，自然林相與生態因而保存相對完整<sup id=\"cite&#95;ref-:1&#95;2-2\" class=\"reference\"><a href=\"#cite_note-:1-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-:2&#95;3-0\" class=\"reference\"><a href=\"#cite_note-:2-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>。原日治時期的設施與周邊土地，在戰後則改為<a href=\"/wiki/%E5%9C%93%E5%B1%B1%E5%A4%A7%E9%A3%AF%E5%BA%97\" title=\"圓山大飯店\">圓山大飯店</a>、<a href=\"/wiki/%E5%9C%8B%E6%B0%91%E9%9D%A9%E5%91%BD%E5%BF%A0%E7%83%88%E7%A5%A0\" title=\"國民革命忠烈祠\">國民革命忠烈祠</a>、<a href=\"/wiki/%E5%9C%8B%E9%98%B2%E9%83%A8%E6%B5%B7%E8%BB%8D%E5%8F%B8%E4%BB%A4%E9%83%A8\" title=\"國防部海軍司令部\">海軍總司令部</a>、梅莊營區、<a href=\"/wiki/%E5%A3%AB%E6%9E%97%E5%AE%98%E9%82%B8\" title=\"士林官邸\">士林官邸</a>；並陸續設置<a href=\"/wiki/%E5%9C%8B%E9%98%B2%E5%A4%A7%E5%AD%B8_(%E4%B8%AD%E8%8F%AF%E6%B0%91%E5%9C%8B)\" title=\"國防大學 (中華民國)\">國防大學</a>、<a href=\"/wiki/%E9%8A%98%E5%82%B3%E5%95%86%E5%B0%88\" class=\"mw-redirect\" title=\"銘傳商專\">銘傳商專</a>、<a href=\"/wiki/%E5%AF%A6%E8%B8%90%E5%AE%B6%E5%B0%88\" class=\"mw-redirect\" title=\"實踐家專\">實踐家專</a>、<a href=\"/wiki/%E5%A4%AA%E5%8E%9F%E4%BA%94%E7%99%BE%E5%AE%8C%E4%BA%BA\" title=\"太原五百完人\">太原五百完人紀念建築群</a>、<a href=\"/w/index.php?title=%E5%8A%8D%E6%BD%AD%E5%85%AC%E5%9C%92&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"劍潭公園（頁面不存在）\">劍潭公園</a>、<a href=\"/w/index.php?title=%E5%8C%97%E5%AE%89%E5%85%AC%E5%9C%92&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"北安公園（頁面不存在）\">北安公園</a>、<a href=\"/wiki/%E9%96%8B%E8%87%BA%E8%81%96%E7%8E%8B%E6%88%90%E5%8A%9F%E5%BB%9F\" title=\"開臺聖王成功廟\">開臺聖王成功廟</a>、天主教大直公墓、<a href=\"/wiki/%E4%B8%AD%E5%A4%AE%E5%BB%A3%E6%92%AD%E9%9B%BB%E8%87%BA\" title=\"中央廣播電臺\">中央廣播電臺</a>圓山微波站等。1969年，藝術家<a href=\"/wiki/%E9%A1%8F%E6%B0%B4%E9%BE%8D\" title=\"顏水龍\">顏水龍</a>於劍潭山西側劍潭公園的擋土牆上，創作了<a href=\"/wiki/%E9%91%B2%E5%B5%8C%E7%95%AB\" class=\"mw-redirect\" title=\"鑲嵌畫\">馬賽克壁畫</a>《<a href=\"/wiki/%E5%BE%9E%E8%BE%B2%E6%A5%AD%E7%A4%BE%E6%9C%83%E5%88%B0%E5%B7%A5%E6%A5%AD%E7%A4%BE%E6%9C%83\" title=\"從農業社會到工業社會\">從農業社會到工業社會</a>》。\n</p><p>軍事管制開放後，<a href=\"/wiki/%E8%87%BA%E5%8C%97%E5%B8%82%E6%94%BF%E5%BA%9C\" title=\"臺北市政府\">臺北市政府</a>在此整建劍潭山步道，惜開放後因缺乏管理，步道沿線遍佈廟宇、山友會、羽球社、體育會等違章建築，以及近300處私設休憩平台<sup id=\"cite&#95;ref-:2&#95;3-1\" class=\"reference\"><a href=\"#cite_note-:2-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>，而台北市政府在近年規劃陸續將其拆除<sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup>。不過，其山間的密林，多樣式植物，還有偶見的<a href=\"/wiki/%E4%BA%94%E8%89%B2%E9%B3%A5\" title=\"五色鳥\">五色鳥</a>及<a href=\"/wiki/%E7%B6%A0%E7%B9%A1%E7%9C%BC\" class=\"mw-redirect\" title=\"綠繡眼\">綠繡眼</a>，仍為其特色。\n</p>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:%E5%9C%93%E5%B1%B1%E9%A2%A8%E6%99%AF%E5%8D%80%E7%89%8C%E5%9D%8A_20251223.jpg\" class=\"mw-file-description\" title=\"圓山風景區牌坊\"><img alt=\"圓山風景區牌坊\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/%E5%9C%93%E5%B1%B1%E9%A2%A8%E6%99%AF%E5%8D%80%E7%89%8C%E5%9D%8A_20251223.jpg/120px-%E5%9C%93%E5%B1%B1%E9%A2%A8%E6%99%AF%E5%8D%80%E7%89%8C%E5%9D%8A_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"120\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/%E5%9C%93%E5%B1%B1%E9%A2%A8%E6%99%AF%E5%8D%80%E7%89%8C%E5%9D%8A_20251223.jpg/250px-%E5%9C%93%E5%B1%B1%E9%A2%A8%E6%99%AF%E5%8D%80%E7%89%8C%E5%9D%8A_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2942\" data-file-height=\"3922\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\">圓山風景區牌坊</div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:%E5%A4%A7%E5%BF%A0%E5%AE%AE_%E5%9C%8B%E5%A7%93%E6%AE%BF_01_20251223.jpg\" class=\"mw-file-description\" title=\"大忠宮國姓殿\"><img alt=\"大忠宮國姓殿\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/%E5%A4%A7%E5%BF%A0%E5%AE%AE_%E5%9C%8B%E5%A7%93%E6%AE%BF_01_20251223.jpg/120px-%E5%A4%A7%E5%BF%A0%E5%AE%AE_%E5%9C%8B%E5%A7%93%E6%AE%BF_01_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"90\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/%E5%A4%A7%E5%BF%A0%E5%AE%AE_%E5%9C%8B%E5%A7%93%E6%AE%BF_01_20251223.jpg/250px-%E5%A4%A7%E5%BF%A0%E5%AE%AE_%E5%9C%8B%E5%A7%93%E6%AE%BF_01_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"4000\" data-file-height=\"3000\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\">大忠宮國姓殿</div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:%E8%87%A5%E9%BE%8D%E5%B4%97%E5%9C%93%E5%B1%B1%E5%A4%A7%E4%BD%9B_02_20251223.jpg\" class=\"mw-file-description\" title=\"臥龍崗圓山大佛\"><img alt=\"臥龍崗圓山大佛\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/51/%E8%87%A5%E9%BE%8D%E5%B4%97%E5%9C%93%E5%B1%B1%E5%A4%A7%E4%BD%9B_02_20251223.jpg/120px-%E8%87%A5%E9%BE%8D%E5%B4%97%E5%9C%93%E5%B1%B1%E5%A4%A7%E4%BD%9B_02_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"89\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/51/%E8%87%A5%E9%BE%8D%E5%B4%97%E5%9C%93%E5%B1%B1%E5%A4%A7%E4%BD%9B_02_20251223.jpg/250px-%E8%87%A5%E9%BE%8D%E5%B4%97%E5%9C%93%E5%B1%B1%E5%A4%A7%E4%BD%9B_02_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3938\" data-file-height=\"2906\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\">臥龍崗圓山大佛</div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E5%B4%97%E5%93%A8_20251223.jpg\" class=\"mw-file-description\" title=\"舊崗哨\"><img alt=\"舊崗哨\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/65/%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E5%B4%97%E5%93%A8_20251223.jpg/120px-%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E5%B4%97%E5%93%A8_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"120\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/65/%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E5%B4%97%E5%93%A8_20251223.jpg/250px-%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E5%B4%97%E5%93%A8_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2934\" data-file-height=\"3912\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\">舊崗哨</div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E7%87%9F%E8%88%8D_20251223.jpg\" class=\"mw-file-description\" title=\"舊營舍\"><img alt=\"舊營舍\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/23/%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E7%87%9F%E8%88%8D_20251223.jpg/120px-%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E7%87%9F%E8%88%8D_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"120\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/23/%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E7%87%9F%E8%88%8D_20251223.jpg/250px-%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E7%87%9F%E8%88%8D_20251223.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2974\" data-file-height=\"3964\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\">舊營舍</div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:%E5%8A%8D%E6%BD%AD%E5%B1%B1%E8%88%8A%E7%A2