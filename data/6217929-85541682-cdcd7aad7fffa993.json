{"schema":1,"revision":85541682,"page":{"pageid":6217929,"title":"舌羊齒屬","displayTitle":"舌羊齒屬","variant":"zh-tw"},"html":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"zh-Hant-TW\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p>\n<table class=\"infobox biota\" style=\"text-align: left; width: 200px; font-size: 100%\">\n\n<tbody><tr>\n<th colspan=\"2\" style=\"text-align: center; background-color: rgb(180,250,180)\"><span style=\"font-style:normal;font-weight:normal;\">†</span>舌羊齒屬<span class=\"plainlinks\" style=\"font-size:smaller; float:right; padding-right:0.4em; margin-left:-3em; margin-top:0.05em;\"><span class=\"skin-invert notpageimage\" typeof=\"mw:File\"><a href=\"/wiki/Help:%E5%A6%82%E4%BD%95%E9%96%B1%E8%AE%80%E7%94%9F%E7%89%A9%E8%B3%87%E8%A8%8A%E6%A1%86\" title=\"Help:如何閱讀生物資訊框\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Infobox_info_icon2.svg/20px-Infobox_info_icon2.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"18\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Infobox_info_icon2.svg/40px-Infobox_info_icon2.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"160\" data-file-height=\"160\" /></a></span></span><br /><div style=\"font-size: 85%;\">化石時期：<span class=\"noprint\"><span style=\"display:inline-block;\"></span><span style=\"display:inline-block;\"><a href=\"/wiki/%E4%BA%8C%E7%96%8A%E7%B4%80\" class=\"mw-redirect\" title=\"二疊紀\">二疊紀</a>–晚<a href=\"/wiki/%E4%BE%8F%E7%BD%97%E7%BA%AA\" title=\"侏羅紀\">侏羅紀</a></span> <span style=\"display:inline-block;\"></span><div id=\"Timeline-row\" style=\"margin: 4px auto 0; clear:both; width:220px; padding:0px; height:18px; overflow:visible; white-space:nowrap; border:1px #666; border-style:solid none; position:relative; z-index:0; font-size:97%;\">\n<div style=\"position:absolute; height:100%; left:0px; width:208.07692307692px; padding-left:5px; text-align:left; background-color:; background-image: linear-gradient(to right, rgba(255,255,255,1), rgba(254,217,106,1) 15%, rgba(254,217,106,1));\"><a href=\"/wiki/%E5%89%8D%E5%AF%92%E6%AD%A6%E7%BA%AA\" title=\"前寒武紀\">PreꞒ</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(129,170,114); left:36.892307692308px; width:18.818461538462px;\"><a href=\"/wiki/%E5%AF%92%E6%AD%A6%E7%BA%AA\" title=\"寒武紀\">Ꞓ</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(0,169,138); left:55.710769230769px; width:14.08px;\"><a href=\"/wiki/%E5%A5%A5%E9%99%B6%E7%BA%AA\" title=\"奧陶紀\">O</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(166,223,197); left:69.790769230769px; width:8.3261538461539px;\"><a href=\"/wiki/%E5%BF%97%E7%95%99%E7%B4%80\" title=\"志留紀\">S</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(221,150,81); left:78.116923076923px; width:20.409230769231px;\"><a href=\"/wiki/%E6%B3%A5%E7%9B%86%E7%BA%AA\" title=\"泥盆紀\">D</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(63,174,173); left:98.526153846154px; width:20.307692307692px;\"><a href=\"/wiki/%E7%9F%B3%E7%82%AD%E7%BA%AA\" title=\"石炭紀\">C</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(247,88,60); left:118.83384615385px; width:15.907015384615px;\"><a href=\"/wiki/%E4%BA%8C%E5%8F%A0%E7%BA%AA\" title=\"二疊紀\">P</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(153,78,150); left:134.74086153846px; width:17.126830769231px;\"><a href=\"/wiki/%E4%B8%89%E5%8F%A0%E7%BA%AA\" title=\"三疊紀\">T</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(0,187,231); left:151.86769230769px; width:19.055384615385px;\"><a href=\"/wiki/%E4%BE%8F%E7%BD%97%E7%BA%AA\" title=\"侏羅紀\">J</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(111,200,107); left:170.92307692308px; width:26.738461538462px;\"><a href=\"/wiki/%E7%99%BD%E5%9E%A9%E7%BA%AA\" title=\"白堊紀\">K</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(254,161,99); left:197.66153846154px; width:14.543692307692px;\"><a href=\"/wiki/%E5%8F%A4%E8%BF%91%E7%BA%AA\" title=\"古近紀\">Pg</a></div>\n<div style=\"position:absolute; height:100%; text-align:center; background-color:rgb(254,221,45); left:212.20523076923px; width:7.7947692307692px;\"><a href=\"/wiki/%E6%96%B0%E8%BF%91%E7%BA%AA\" title=\"新近紀\">N</a></div>\n<div id=\"end-border\" style=\"position:absolute; height:100%; background-color:#666; width:1px; left:219px\"></div><div style=\"margin:0 auto; line-height:0; clear:both; width:220px; padding:0px; height:8px; overflow:visible; background-color:transparent; position:relative; top:-4px; z-index:100;\"><div style=\"position:absolute; height:8px; left:120.15384615385px; width:50.6px; background-color:#360; opacity:0.42;\"></div>\n<div style=\"position:absolute; height:8px; left:120.15384615385px; width:50.6px; background-color:#360; opacity:1;\"></div>\n<div style=\"position:absolute; height:6px; top:1px; left:121.15384615385px; width:48.6px; background-color:#6c3;\"></div>\n</div>\n</div></span></div>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Glossopteris_sp.,_seed_ferns,_Permian_-_Triassic_-_Houston_Museum_of_Natural_Science_-_DSC01765.JPG\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Glossopteris_sp.%2C_seed_ferns%2C_Permian_-_Triassic_-_Houston_Museum_of_Natural_Science_-_DSC01765.JPG/250px-Glossopteris_sp.%2C_seed_ferns%2C_Permian_-_Triassic_-_Houston_Museum_of_Natural_Science_-_DSC01765.JPG?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"333\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Glossopteris_sp.%2C_seed_ferns%2C_Permian_-_Triassic_-_Houston_Museum_of_Natural_Science_-_DSC01765.JPG/500px-Glossopteris_sp.%2C_seed_ferns%2C_Permian_-_Triassic_-_Houston_Museum_of_Natural_Science_-_DSC01765.JPG?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3240\" data-file-height=\"4320\" /></a></span>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center; font-size: 88%\">舌羊齒的<a href=\"/wiki/%E8%91%89\" title=\"葉\">葉</a>化石\n</td></tr>\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"color:inherit; min-width:15em; text-align: center; background-color: rgb(180,250,180)\"><a href=\"/wiki/%E7%94%9F%E7%89%A9%E5%88%86%E7%B1%BB%E5%AD%A6\" title=\"生物分類學\">科學分類</a> <span class=\"plainlinks taxobox-edit-taxonomy skin-invert\" style=\"font-size:smaller; float:right; padding-right:0.4em; margin-left:-3em;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Template:Taxonomy/Glossopteris\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Small_Pencil_Icon.svg/20px-Small_Pencil_Icon.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"16\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Small_Pencil_Icon.svg/40px-Small_Pencil_Icon.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"16\" data-file-height=\"16\" /></a></span></span>\n</th></tr>\n<tr>\n<td><span class=\"nowrap\">界：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E6%A4%8D%E7%89%A9%E7%95%8C\" class=\"mw-redirect\" title=\"植物界\">植物界</a> Plantae</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\"><small>演化支</small>：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E7%BB%B4%E7%AE%A1%E6%A4%8D%E7%89%A9\" title=\"維管植物\">維管束植物</a> Tracheophyta</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\">目：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E8%88%8C%E7%BE%8A%E9%BD%92%E7%9B%AE\" title=\"舌羊齒目\"><span style=\"font-style:normal;font-weight:normal;\">†</span>舌羊齒目</a> Glossopteridales</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\">科：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/w/index.php?title=%E8%88%8C%E7%BE%8A%E9%BD%BF%E7%A7%91&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"舌羊齒科（頁面不存在）\"><span style=\"font-style:normal;font-weight:normal;\">†</span>舌羊齒科</a> Glossopteridaceae</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\">屬：</span>\n</td>\n<td><span class=\"nowrap\"><b><span style=\"font-style:normal;font-weight:normal;\">†</span>舌羊齒屬 <i>Glossopteris</i></b></span><br /><small>Brongniart, 1828 ex Brongniart, 1831</small>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align: center; background-color: rgb(180,250,180)\"><a href=\"/wiki/%E7%A8%AE\" class=\"mw-redirect\" title=\"種\">種</a>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: left\">\n<p><a href=\"#物種\">見內文</a>\n</p>\n</td></tr>\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Pangaea_Glossopteris.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Pangaea_Glossopteris.jpg/250px-Pangaea_Glossopteris.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"154\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Pangaea_Glossopteris.jpg/500px-Pangaea_Glossopteris.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"633\" data-file-height=\"389\" /></a></span>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center; font-size: 88%\">舌羊齒化石的分布地域圖（深綠色區域），提供了強而有力的證據表明現今各大陸在過去曾經是合併在一塊的<a href=\"/wiki/%E5%86%88%E7%93%A6%E7%BA%B3%E5%A4%A7%E9%99%86\" title=\"岡瓦納大陸\">岡瓦納大陸</a>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n</tbody></table><style data-mw-deduplicate=\"TemplateStyles:r95173204\">@media(max-width:640px){body:not(.skin-minerva) .mw-parser-output .infobox{width:100%!important}body:not(.skin-minerva) .mw-parser-output .infobox th{width:50%}}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox.biota tr{background:transparent!important}html.skin-theme-clientpref-night .mw-parser-output .infobox.biota img{background:transparent}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox.biota tr{background:transparent!important}html.skin-theme-clientpref-os .mw-parser-output .infobox.biota img{background:white}}.mw-parser-output .infobox.biota .taxobox-edit-taxonomy img{background:transparent!important}body.skin-vector .mw-parser-output table.biota.infobox{margin-top:0.5em}body.skin--responsive .mw-parser-output table.biota.infobox tr.taxonrow2 td{padding:2px 10px}</style>\n<p><b>舌羊齒屬</b>（<a href=\"/wiki/%E5%AD%B8%E5%90%8D\" title=\"學名\">學名</a>：<span title=\"拉丁語文本\"><span lang=\"la\"><i><b>Glossopteris</b></i></span></span>），又名<b>舌葉松屬</b>，是一<a href=\"/wiki/%E5%B1%AC\" class=\"mw-redirect\" title=\"屬\">屬</a>已<a href=\"/wiki/%E6%BB%85%E7%B5%95\" class=\"mw-redirect\" title=\"滅絕\">滅絕</a>的<a href=\"/wiki/%E7%A8%AE%E5%AD%90%E8%95%A8\" class=\"mw-redirect\" title=\"種子蕨\">種子蕨</a>，生存於<a href=\"/wiki/%E4%BA%8C%E7%96%8A%E7%B4%80\" class=\"mw-redirect\" title=\"二疊紀\">二疊紀</a>至<a href=\"/wiki/%E4%BE%8F%E7%BE%85%E7%B4%80\" class=\"mw-redirect\" title=\"侏羅紀\">侏羅紀</a>晚期。它們生長在溫暖潮濕的低窪地帶。其<a href=\"/wiki/%E5%8C%96%E7%9F%B3\" title=\"化石\">化石</a>主要分布於<a href=\"/wiki/%E5%8D%97%E5%8D%8A%E7%90%83\" title=\"南半球\">南半球</a>及<a href=\"/wiki/%E5%8D%B0%E5%BA%A6\" title=\"印度\">印度</a><sup id=\"cite&#95;ref-Fossils&#95;1-0\" class=\"reference\"><a href=\"#cite_note-Fossils-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>，從其化石的分布地帶可證明<a href=\"/wiki/%E5%A4%A7%E9%99%86%E6%BC%82%E7%A7%BB%E5%81%87%E8%AF%B4\" class=\"mw-redirect\" title=\"大陸漂移假說\">大陸漂移假說</a>的真實性。\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"特徵\"><span id=\".E7.89.B9.E5.BE.B5\"></span>特徵</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%88%8C%E7%BE%8A%E9%BD%92%E5%B1%AC&amp;action=edit&amp;section=1\" title=\"編輯章節：特徵\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>舌羊齒的典型植株高度約為8<a href=\"/wiki/%E5%85%AC%E5%B0%BA\" class=\"mw-redirect\" title=\"公尺\">公尺</a>，呈<a href=\"/wiki/%E5%96%AC%E6%9C%A8\" class=\"mw-redirect\" title=\"喬木\">喬木</a>狀。<a href=\"/wiki/%E8%91%89%E7%89%87\" class=\"mw-redirect\" title=\"葉片\">葉片</a>的大小與寬度各異，呈<a href=\"/wiki/%E7%BE%8A\" title=\"羊\">羊</a><a href=\"/wiki/%E8%88%8C\" title=\"舌\">舌</a>狀，故名舌羊齒。葉的脈絡由寬闊的中央<a href=\"/wiki/%E5%8F%B6%E8%84%89\" title=\"葉脈\">葉脈</a>和許多更小的葉脈組成，葉的網狀脈絡將葉面分割成許多<a href=\"/wiki/%E8%8F%B1%E5%BD%A2\" title=\"菱形\">菱形</a>。<a href=\"/wiki/%E6%A8%B9%E5%B9%B9\" title=\"樹幹\">樹幹</a>內部為<a href=\"/wiki/%E8%BB%9F%E6%9C%A8\" title=\"軟木\">軟木</a>質<sup id=\"cite&#95;ref-Fossils&#95;1-1\" class=\"reference\"><a href=\"#cite_note-Fossils-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>，類似於<a href=\"/wiki/%E5%8D%97%E6%B4%8B%E6%9D%89%E7%A7%91\" title=\"南洋杉科\">南洋杉科</a>的<a href=\"/wiki/%E9%87%9D%E8%91%89%E6%A8%B9\" class=\"mw-redirect\" title=\"針葉樹\">針葉樹</a><sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>。產生<a href=\"/wiki/%E8%8A%B1%E7%B2%89\" title=\"花粉\">花粉</a>及<a href=\"/wiki/%E7%A8%AE%E5%AD%90\" title=\"種子\">種子</a>的<a href=\"/wiki/%E5%99%A8%E5%AE%98\" title=\"器官\">器官</a>融合或貼生於葉上。<sup id=\"cite&#95;ref-Fossils&#95;1-2\" class=\"reference\"><a href=\"#cite_note-Fossils-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"物種\"><span id=\".E7.89.A9.E7.A8.AE\"></span>物種</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%88%8C%E7%BE%8A%E9%BD%92%E5%B1%AC&amp;action=edit&amp;section=2\" title=\"編輯章節：物種\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><i>Glossopteris angustifolia</i> <small></small></li>\n<li><i>Glossopteris brasiliensis</i> <small></small></li>\n<li><i>Glossopteris browniana</i> <small></small></li>\n<li><i>Glossopteris communis</i> <small></small></li>\n<li><i>Glossopteris indica</i> <small></small></li>\n<li><i>Glossopteris occidentalis</i> <small></small></li></ul>\n<figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File/Thumb\"><a href=\"/wiki/File:Wegener_fossils-mapped.png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Wegener_fossils-mapped.png/250px-Wegener_fossils-mapped.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"148\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Wegener_fossils-mapped.png/500px-Wegener_fossils-mapped.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2742\" data-file-height=\"1628\" /></a><figcaption>二疊紀三疊紀期間的重要代表化石分布，被視為是大陸漂移的證據：<style data-mw-deduplicate=\"TemplateStyles:r84565780\">.mw-parser-output .legend{page-break-inside:avoid;break-inside:avoid-column}.mw-parser-output .legend-color{display:inline-block;min-width:1.25em;height:1.25em;line-height:1.25;margin:1px 0;text-align:center;border:1px solid var(--border-color-notice,black);color:inherit}.mw-parser-output .legend-color-styled{display:inline-block;min-width:1.25em;height:1.25em;line-height:1.25;margin:1px 0;text-align:center;border:1px solid var(--border-color-notice,black);color:inherit}.mw-parser-output .legend-text{}</style><div class=\"legend\"><span class=\"legend-color mw-no-invert\" style=\"background-color:#ffb300; color:black;\">&#160;</span>&#160;<a href=\"/wiki/%E7%8A%AC%E9%A0%9C%E7%8D%B8%E5%B1%AC\" title=\"犬頜獸屬\">犬頜獸屬</a>（<i>Cynognathus</i>）</div> <link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r84565780\" /><div class=\"legend\"><span class=\"legend-color mw-no-invert\" style=\"background-color:#32b923; color:black;\">&#160;</span>&#160;<a href=\"/wiki/%E4%B8%AD%E9%BE%8D%E5%B1%AC\" title=\"中龍屬\">中龍屬</a>（<i>Mesosaurus</i>）</div> <link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r84565780\" /><div class=\"legend\"><span class=\"legend-color mw-no-invert\" style=\"background-color:#ffff62; color:black;\">&#160;</span>&#160;<a href=\"/wiki/%E6%B0%B4%E9%BE%8D%E7%8D%B8%E5%B1%AC\" title=\"水龍獸屬\">水龍獸屬</a>（<i>Lystrosaurus</i>）</div> <link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r84565780\" /><div class=\"legend\"><span class=\"legend-color mw-no-invert\" style=\"background-color:#2eacd7; color:black;\">&#160;</span>&#160;<a href=\"/wiki/%E8%88%8C%E7%BE%8A%E9%BD%BF%E5%B1%9E\" class=\"mw-redirect\" title=\"舌羊齒屬\">舌羊齒屬</a>（<i>Glossopteris</i>）</div></figcaption></figure>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"參考文獻\"><span id=\".E5.8F.83.E8.80.83.E6.96.87.E7.8D.BB\"></span>參考文獻</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\"