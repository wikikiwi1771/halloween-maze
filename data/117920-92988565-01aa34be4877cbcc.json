{"schema":1,"revision":92988565,"page":{"pageid":117920,"title":"索引","displayTitle":"索引","variant":"zh-tw"},"html":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"zh-Hant-TW\" dir=\"ltr\"><style data-mw-deduplicate=\"TemplateStyles:r95173168\">@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style],html.skin-theme-clientpref-night .mw-parser-output .infobox td>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}html.skin-theme-clientpref-night .mw-parser-output .infobox td>div.NavHead:not(.notheme)[style]{background:transparent!important}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style],html.skin-theme-clientpref-os .mw-parser-output .infobox td>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}html.skin-theme-clientpref-os .mw-parser-output .infobox td>div.NavHead:not(.notheme)[style]{background:transparent!important}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style><table class=\"infobox\" style=\"float:right;border:1px solid #aaa;max-width:300px;min-width:200px;padding:0 0.4em;margin:0 0 0.4em 0.4em;\"><tbody><tr><th colspan=\"2\" class=\"infobox-above\" style=\"text-align:center;background-color:#f5f5f5;padding:0.5em 0;margin:0.5em 0;font-size:120%;font-weight:bold\">索引</th></tr><tr><td colspan=\"2\" class=\"infobox-image\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg/250px-Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"420\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg/500px-Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1209\" data-file-height=\"2029\" /></a></span></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color:#f5f5f5;font-weight:bold;margin-top:0.2em\"><span><span>書籍形態</span></span></th></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"min-width: 4em;max-width:6em;;\">上級分類</th><td class=\"infobox-data\" style=\"\"><span><span><a href=\"/wiki/%E5%B7%A5%E5%85%B7%E4%B9%A6\" title=\"工具書\">工具書</a></span>、​<span>列表</span></span>&#160;<span class=\"mw-valign-baseline noviewer skin-invert\" typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q873506#P279\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/20px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/40px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"min-width: 4em;max-width:6em;;\">表現概念</th><td class=\"infobox-data\" style=\"\"><span><span>建立索引</span></span>&#160;<span class=\"mw-valign-baseline noviewer skin-invert\" typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q873506#P1557\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/20px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/40px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr></tbody></table>\n<style data-mw-deduplicate=\"TemplateStyles:r95173172\">.mw-parser-output .hatnote{font-size:small}.mw-parser-output div.hatnote{padding-left:2em;margin-bottom:0.8em;margin-top:0.8em}.mw-parser-output .hatnote-notice-img::after{content:\"\\202f \\202f \\202f \\202f \"}.mw-parser-output .hatnote-notice-img-small::after{content:\"\\202f \\202f \"}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}body.skin-minerva .mw-parser-output .hatnote-notice-img,body.skin-minerva .mw-parser-output .hatnote-notice-img-small{display:none}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style><div role=\"note\" class=\"hatnote navigation-not-searchable\"><span class=\"noviewer hatnote-notice-img\" typeof=\"mw:File\"><a href=\"/wiki/Wikipedia:%E6%B6%88%E6%AD%A7%E4%B9%89\" title=\"Wikipedia:消歧義\"><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Disambig_gray.svg/40px-Disambig_gray.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"19\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Disambig_gray.svg/60px-Disambig_gray.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"220\" data-file-height=\"168\" /></a></span>此條目介紹的是書面意義的快速查找記錄。關於資料庫的快速查找記錄，請見「<b><a href=\"/wiki/%E6%95%B0%E6%8D%AE%E5%BA%93%E7%B4%A2%E5%BC%95\" title=\"資料庫索引\">資料庫索引</a></b>」。</div>\n<p><b>索引</b>（<a href=\"/wiki/%E6%8B%89%E4%B8%81%E8%AA%9E\" class=\"mw-redirect\" title=\"拉丁語\">拉丁語</a>：<span lang=\"la\">Index</span>），又稱<b>引得</b>、<b>通檢</b>、<b>備檢</b>，是一本<a href=\"/wiki/%E4%B9%A6%E7%B1%8D\" class=\"mw-redirect\" title=\"書籍\">書籍</a>的重要組成部分，它把書中的重要語詞或要項羅列出來，並給出它們相應的<a href=\"/wiki/%E9%A1%B5%E7%A0%81\" title=\"頁碼\">頁碼</a>，方便讀者快速查閱該名詞的定義和含義。<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>索引不同於<a href=\"/w/index.php?title=%E8%AF%8D%E8%AF%AD%E7%B4%A2%E5%BC%95&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"詞語索引（頁面不存在）\">詞語索引</a>（concordance）：詞語索引列出的是文本中的精確用詞，而索引關注的是文本的主題概念。索引也不同於<a href=\"/wiki/%E7%9B%AE%E6%AC%A1\" title=\"目次\">目錄</a>：目錄按書中出現的順序排列章節標題，而索引按主題字母順序排列，不論該主題出現在書的早前還是靠後部分。<sup id=\"cite&#95;ref-Duncan2022&#95;2-0\" class=\"reference\"><a href=\"#cite_note-Duncan2022-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>在<a href=\"/wiki/%E5%9B%BE%E4%B9%A6%E9%A6%86%E7%9B%AE%E5%BD%95\" class=\"mw-redirect\" title=\"圖書館目錄\">圖書館目錄</a>中，索引記錄的是作者、書名和主題詞，其指針（locator）是<a href=\"/wiki/%E7%B4%A2%E6%9B%B8%E8%99%9F\" class=\"mw-redirect\" title=\"索書號\">索書號</a>。<span title=\"英語文本\"><span lang=\"en\">Index</span></span>一詞的概念也被借用到<a href=\"/wiki/%E6%95%B0%E6%8D%AE%E5%BA%93%E7%B4%A2%E5%BC%95\" title=\"資料庫索引\">資料庫索引</a>等計算機技術領域。\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"历史\"><span id=\".E5.8E.86.E5.8F.B2\"></span>歷史</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=1\" title=\"編輯章節：歷史\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"英文书籍索引\"><span id=\".E8.8B.B1.E6.96.87.E4.B9.A6.E7.B1.8D.E7.B4.A2.E5.BC.95\"></span>英文書籍索引</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=2\" title=\"編輯章節：英文書籍索引\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>已知最早的現代意義上的英文書籍索引之一是<a href=\"/w/index.php?title=%E8%8E%B1%E6%98%82%E7%BA%B3%E5%BE%B7%C2%B7%E9%A9%AC%E6%96%AF%E7%A7%91%E5%B0%94&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"萊昂納德·馬斯科爾（頁面不存在）\">萊昂納德·馬斯科爾</a>1575年出版的《種植與嫁接各類樹木的技藝》一書末尾的索引。<sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>1595年托馬斯·諾斯爵士翻譯的<a href=\"/wiki/%E6%99%AE%E9%B2%81%E5%A1%94%E5%85%8B\" class=\"mw-redirect\" title=\"普魯塔克\">普魯塔克</a>《<a href=\"/wiki/%E5%90%8D%E4%BA%BA%E4%BC%A0\" title=\"名人傳\">名人傳</a>》中也包含索引。<a href=\"/wiki/%E5%A8%81%E5%BB%89%C2%B7%E8%8E%8E%E5%A3%AB%E6%AF%94%E4%BA%9A\" title=\"威廉·莎士比亞\">威廉·莎士比亞</a>在《<a href=\"/wiki/%E7%89%B9%E6%B4%9B%E4%BC%8A%E7%BE%85%E6%96%AF%E8%88%87%E5%85%8B%E7%91%9E%E8%A5%BF%E9%81%94\" title=\"特洛伊羅斯與克瑞西達\">特洛伊羅斯與克瑞西達</a>》（1602年）中寫下了著名的關於索引的詩句：「而在這樣的索引中，雖然對於後續的卷冊只是小小的刺點，卻已能看到龐大體積的巨大形象的嬰兒身形。」<sup id=\"cite&#95;ref-Knight1979&#95;4-0\" class=\"reference\"><a href=\"#cite_note-Knight1979-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"中文索引\"><span id=\".E4.B8.AD.E6.96.87.E7.B4.A2.E5.BC.95\"></span>中文索引</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=3\" title=\"編輯章節：中文索引\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<figure class=\"mw-default-size\" typeof=\"mw:File/Thumb\"><a href=\"/wiki/File:Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg/250px-Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"420\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg/500px-Novus_Atlas_Sinensis_-_First_page_of_the_index.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1209\" data-file-height=\"2029\" /></a><figcaption>1655年<a href=\"/wiki/%E5%8D%AB%E5%8C%A1%E5%9B%BD\" title=\"衛匡國\">衛匡國</a>《中國新圖志》</figcaption></figure><p>西方傳教士編纂的中文地圖和詞典在17世紀即已包含索引式的檢索系統，如1655年衛匡國《<a href=\"/w/index.php?title=%E4%B8%AD%E5%9B%BD%E6%96%B0%E5%9B%BE%E5%BF%97&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"中國新圖志（頁面不存在）\">中國新圖志</a>》。\n</p><p>中文索引的發展面臨獨特挑戰：漢語不像西方語言那樣使用字母排序，因此<span title=\"英語文本\"><span lang=\"en\">index</span></span>一詞在中文語境中早期音譯為「引得」，意譯為「索引」。早在18世紀初，<a href=\"/w/index.php?title=%E3%80%8A%E5%BA%B7%E7%86%99%E5%AD%97%E5%85%B8%E3%80%8B&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"《康熙字典》（頁面不存在）\">《康熙字典》</a>（1716年）等大型工具書已採用<a href=\"/wiki/%E9%83%A8%E9%A6%96\" title=\"部首\">部首</a>檢字法作為字符檢索手段，這本質上是一種索引系統。1782年成書的《<a href=\"/wiki/%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E7%B8%BD%E7%9B%AE%E6%8F%90%E8%A6%81\" class=\"mw-redirect\" title=\"四庫全書總目提要\">四庫全書總目提要</a>》是一部規模宏大的分類目錄，包含大量的交叉參考。\n</p><p>1933年，<a href=\"/w/index.php?title=%E8%92%8B%E4%B8%80%E5%89%8D&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"蔣一前（頁面不存在）\">蔣一前</a>出版了《中國檢字法沿革史略及七十七種新檢字法表》，這是已知最早的中文索引方法專著。<sup id=\"cite&#95;ref-Chen2021&#95;5-0\" class=\"reference\"><a href=\"#cite_note-Chen2021-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup>20世紀上半葉，中國索引事業取得了顯著進展：<a href=\"/wiki/%E8%90%AC%E5%9C%8B%E9%BC%8E\" title=\"萬國鼎\">萬國鼎</a>（1897–1963）是早期索引先驅之一；<a href=\"/wiki/%E7%8E%8B%E4%BA%91%E4%BA%94\" class=\"mw-redirect\" title=\"王雲五\">王雲五</a>發明的<a href=\"/wiki/%E5%9B%9B%E8%A7%92%E5%8F%B7%E7%A0%81\" title=\"四角號碼\">四角號碼</a>檢字法在詞典和索引領域得到廣泛應用。<sup id=\"cite&#95;ref-Dai2008&#95;6-0\" class=\"reference\"><a href=\"#cite_note-Dai2008-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup>1991年，<a href=\"/w/index.php?title=%E4%B8%AD%E5%9B%BD%E7%B4%A2%E5%BC%95%E5%AD%A6%E4%BC%9A&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"中國索引學會（頁面不存在）\">中國索引學會</a>在<a href=\"/wiki/%E5%A4%8D%E6%97%A6%E5%A4%A7%E5%AD%A6\" title=\"復旦大學\">復旦大學</a>成立，標誌著中國索引事業的專業化和制度化。<sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"编制流程\"><span id=\".E7.BC.96.E5.88.B6.E6.B5.81.E7.A8.8B\"></span>編制流程</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=4\" title=\"編輯章節：編制流程\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"传统索引\"><span id=\".E4.BC.A0.E7.BB.9F.E7.B4.A2.E5.BC.95\"></span>傳統索引</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=5\" title=\"編輯章節：傳統索引\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>索引編制者通讀文本，識別可索引的概念——即那些提供了有用信息且對目標讀者群具有相關性的內容。編制者隨後創建索引標目來代表這些概念，並以易於按字母順序查找的方式措辭（例如，使用「索引編制過程」而非「如何創建索引」）。標目及其對應的定位符（通常為頁碼）被錄入專門的<a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95%E8%BD%AF%E4%BB%B6&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"索引軟體（頁面不存在）\">索引軟體</a>進行處理和格式化。編制完成的索引需經過編輯以確保全書的標目風格一致。<sup id=\"cite&#95;ref-ASIFAQ&#95;8-0\" class=\"reference\"><a href=\"#cite_note-ASIFAQ-8\"><span class=\"cite-bracket\">&#91;</span>8<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>在索引軟體出現之前，索引者使用紙片或<a href=\"/wiki/%E7%B4%A2%E5%BC%95%E5%8D%A1\" title=\"索引卡\">索引卡</a>逐條記錄標目，完成數百張後手工排序，再作為<a href=\"/wiki/%E6%89%8B%E7%A8%BF\" class=\"mw-redirect\" title=\"手稿\">手稿</a>交排字工人印刷。索引者須充當文本與其最終用戶之間的橋梁——讀者需要的是能幫助找到信息的索引，而非簡單重複作者使用的措辭。\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"嵌入索引\"><span id=\".E5.B5.8C.E5.85.A5.E7.B4.A2.E5.BC.95\"></span>嵌入索引</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=6\" title=\"編輯章節：嵌入索引\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>嵌入索引是指將索引標目以編碼形式直接嵌入正文之中，在正常顯示時不可見。當頁面布局改變時，利用嵌入標目的位置可自動重新生成索引。<a href=\"/wiki/LaTeX\" title=\"LaTeX\">LaTeX</a>文檔通過MakeIndex包支持嵌入索引；<a href=\"/wiki/XML\" title=\"XML\">XML</a>格式（如<a href=\"/wiki/DocBook\" title=\"DocBook\">DocBook</a>和<a href=\"/wiki/TEI\" class=\"mw-redirect\" title=\"TEI\">TEI</a>）也提供嵌入索引的元素。<a href=\"/wiki/Microsoft_Word\" title=\"Microsoft Word\">Microsoft Word</a>、<a href=\"/wiki/OpenOffice\" class=\"mw-disambig\" title=\"OpenOffice\">OpenOffice</a>、<a href=\"/w/index.php?title=Adobe_FrameMaker&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Adobe FrameMaker（頁面不存在）\">Adobe FrameMaker</a>和<a href=\"/wiki/Adobe_InDesign\" title=\"Adobe InDesign\">Adobe InDesign</a>等軟體亦具備嵌入索引功能。<sup id=\"cite&#95;ref-ASIFAQ&#95;8-1\" class=\"reference\"><a href=\"#cite_note-ASIFAQ-8\"><span class=\"cite-bracket\">&#91;</span>8<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"索引质量\"><span id=\".E7.B4.A2.E5.BC.95.E8.B4.A8.E9.87.8F\"></span>索引質量</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=7\" title=\"編輯章節：索引質量\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>好的索引應遵循以下原則：每個主題包含2至3條相關條目；使用一致的格式（單數/複數、大小寫等）；考慮目標讀者可能查找的條目。常見的索引錯誤包括：重要主題完全沒有索引條目；將不重要的「順帶提及」編入索引；出現循環交叉引用（如「貓科. 見 貓」/「貓. 見 貓科」）；將同一主題分散在多個不相關的主標目下；類似主題的索引不一致；按計算機自動生成的章節標題編排索引。<sup id=\"cite&#95;ref-9\" class=\"reference\"><a href=\"#cite_note-9\"><span class=\"cite-bracket\">&#91;</span>9<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"索引员与学会\"><span id=\".E7.B4.A2.E5.BC.95.E5.91.98.E4.B8.8E.E5.AD.A6.E4.BC.9A\"></span>索引員與學會</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=8\" title=\"編輯章節：索引員與學會\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>索引編制是一個專業領域。在美國、英國、加拿大、澳大利亞和紐西蘭等國均有專業的索引學會。<a href=\"/w/index.php?title=%E4%B8%AD%E5%9B%BD%E7%B4%A2%E5%BC%95%E5%AD%A6%E4%BC%9A&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"中國索引學會（頁面不存在）\">中國索引學會</a>於1991年在<a href=\"/wiki/%E5%A4%8D%E6%97%A6%E5%A4%A7%E5%AD%A6\" title=\"復旦大學\">復旦大學</a>成立，是中國唯一專門從事索引研究的學術團體，出版《中國索引》期刊。國際標準ISO 999和ANSI/NISO Z39.4對索引的內容、組織和呈現方式提供了指導。<sup id=\"cite&#95;ref-10\" class=\"reference\"><a href=\"#cite_note-10\"><span class=\"cite-bracket\">&#91;</span>10<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"参见\"><span id=\".E5.8F.82.E8.A7.81\"></span>參見</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=9\" title=\"編輯章節：參見\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/%E7%9B%AE%E6%AC%A1\" title=\"目次\">目錄</a></li>\n<li><a href=\"/wiki/%E6%95%B0%E6%8D%AE%E5%BA%93%E7%B4%A2%E5%BC%95\" title=\"資料庫索引\">資料庫索引</a></li>\n<li><a href=\"/wiki/%E6%90%9C%E7%B4%A2%E5%BC%95%E6%93%8E%E7%B4%A2%E5%BC%95\" title=\"搜尋引擎索引\">搜尋引擎索引</a></li>\n<li><a href=\"/wiki/%E5%9B%9B%E8%A7%92%E5%8F%B7%E7%A0%81\" title=\"四角號碼\">四角號碼</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"参考文献\"><span id=\".E5.8F.82.E8.80.83.E6.96.87.E7.8C.AE\"></span>參考文獻</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E7%B4%A2%E5%BC%95&amp;action=edit&amp;section=10\" title=\"編輯章節：參考文獻\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r95310437\">.mw-parser-output .reflist{margin-bottom:0.5em;list-style-type:decimal}@media screen{.mw-parser-output .reflist{font-size:90%}}.mw-parser-output .reflist .references{font-size:100%;margin-bottom:0;list-style-type:inherit}.mw-parser-output .reflist-columns{margin-top:0.3em}.mw-parser-output .reflist-columns ol{margin-top:0}.mw-parser-output .reflist-columns li{page-break-inside:avoid;break-inside:avoid-column}.mw-parser-output .reflist-upper-alpha{list-style-type:upper-alpha}.mw-parser-output .reflist-upper-roman{list-style-type:upper-roman}.mw-parser-output .reflist-lower-alpha{list-style-type:lower-alpha}.mw-parser-output .reflist-lower-greek{list-style-type:lower-greek}.mw-parser-output .reflist-lower-roman{list-style-type:lower-roman}</style><div class=\"reflist reflist-columns\" style=\"column-count: 2;\"><ol class=\"references\">\n<li id=\"cite&#95;note-1\"><span class=\