{"schema":1,"revision":94690237,"page":{"pageid":500910,"title":"薯蕷科","displayTitle":"薯蕷科","variant":"zh-tw"},"html":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"zh-Hant-TW\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p>\n<table class=\"infobox biota\" style=\"text-align: left; width: 200px; font-size: 100%\">\n\n<tbody><tr>\n<th colspan=\"2\" style=\"text-align: center; background-color: rgb(180,250,180)\">薯蕷科<span class=\"plainlinks\" style=\"font-size:smaller; float:right; padding-right:0.4em; margin-left:-3em; margin-top:0.05em;\"><span class=\"skin-invert notpageimage\" typeof=\"mw:File\"><a href=\"/wiki/Help:%E5%A6%82%E4%BD%95%E9%96%B1%E8%AE%80%E7%94%9F%E7%89%A9%E8%B3%87%E8%A8%8A%E6%A1%86\" title=\"Help:如何閱讀生物資訊框\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Infobox_info_icon2.svg/20px-Infobox_info_icon2.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"18\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Infobox_info_icon2.svg/40px-Infobox_info_icon2.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"160\" data-file-height=\"160\" /></a></span></span>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Dioscorea_polystachya_(batatas).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3b/Dioscorea_polystachya_%28batatas%29.jpg/250px-Dioscorea_polystachya_%28batatas%29.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"174\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3b/Dioscorea_polystachya_%28batatas%29.jpg/500px-Dioscorea_polystachya_%28batatas%29.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"906\" data-file-height=\"632\" /></a></span>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center; font-size: 88%\"><a href=\"/wiki/%E5%B1%B1%E8%8D%AF\" class=\"mw-redirect\" title=\"山藥\">山藥</a> <i>Dioscorea polystachya</i>\n</td></tr>\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"color:inherit; min-width:15em; text-align: center; background-color: rgb(180,250,180)\"><a href=\"/wiki/%E7%94%9F%E7%89%A9%E5%88%86%E7%B1%BB%E5%AD%A6\" title=\"生物分類學\">科學分類</a> <span class=\"plainlinks taxobox-edit-taxonomy skin-invert\" style=\"font-size:smaller; float:right; padding-right:0.4em; margin-left:-3em;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Template:Taxonomy/Dioscoreaceae\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Small_Pencil_Icon.svg/20px-Small_Pencil_Icon.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"16\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Small_Pencil_Icon.svg/40px-Small_Pencil_Icon.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"16\" data-file-height=\"16\" /></a></span></span>\n</th></tr>\n<tr>\n<td><span class=\"nowrap\">界：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E6%A4%8D%E7%89%A9%E7%95%8C\" class=\"mw-redirect\" title=\"植物界\">植物界</a> Plantae</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\"><small>演化支</small>：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E7%BB%B4%E7%AE%A1%E6%A4%8D%E7%89%A9\" title=\"維管植物\">維管束植物</a> Tracheophyta</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\"><small>演化支</small>：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E8%A2%AB%E5%AD%90%E6%A4%8D%E7%89%A9\" title=\"被子植物\">被子植物</a> Angiosperms</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\"><small>演化支</small>：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E5%8D%95%E5%AD%90%E5%8F%B6%E6%A4%8D%E7%89%A9\" class=\"mw-redirect\" title=\"單子葉植物\">單子葉植物</a> Monocots</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\">目：</span>\n</td>\n<td><span class=\"nowrap\"><a href=\"/wiki/%E8%96%AF%E8%93%A3%E7%9B%AE\" title=\"薯蕷目\">薯蕷目</a> Dioscoreales</span>\n</td></tr>\n<tr>\n<td><span class=\"nowrap\">科：</span>\n</td>\n<td><span class=\"nowrap\"><b>薯蕷科 Dioscoreaceae</b></span><br /><small><a href=\"/wiki/R.Br.\" class=\"mw-redirect\" title=\"R.Br.\">R.Br.</a>, 1810</small>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align: center; background-color: rgb(180,250,180)\"><a href=\"/wiki/%E6%A8%A1%E5%BC%8F%E5%B1%9E\" title=\"模式屬\">模式屬</a>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><a href=\"/wiki/%E8%96%AF%E8%93%A3%E5%B1%9E\" title=\"薯蕷屬\">薯蕷屬</a><br /><i>Dioscorea</i><br /><div style=\"font-size: 85%;\"><a href=\"/w/index.php?title=Plum.&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Plum.（頁面不存在）\">Plum.</a> ex <a href=\"/wiki/L.\" class=\"mw-redirect\" title=\"L.\">L.</a>, 1753</div>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align: center; background-color: rgb(180,250,180)\"><a href=\"/wiki/%E5%B1%9E\" title=\"屬\">屬</a>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: left\">\n<p>參見正文\n</p>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</tbody></table><style data-mw-deduplicate=\"TemplateStyles:r95173204\">@media(max-width:640px){body:not(.skin-minerva) .mw-parser-output .infobox{width:100%!important}body:not(.skin-minerva) .mw-parser-output .infobox th{width:50%}}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox.biota tr{background:transparent!important}html.skin-theme-clientpref-night .mw-parser-output .infobox.biota img{background:transparent}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox.biota tr{background:transparent!important}html.skin-theme-clientpref-os .mw-parser-output .infobox.biota img{background:white}}.mw-parser-output .infobox.biota .taxobox-edit-taxonomy img{background:transparent!important}body.skin-vector .mw-parser-output table.biota.infobox{margin-top:0.5em}body.skin--responsive .mw-parser-output table.biota.infobox tr.taxonrow2 td{padding:2px 10px}</style>\n<p><b>薯蕷科</b>（<a href=\"/wiki/%E5%AD%A6%E5%90%8D\" class=\"mw-redirect\" title=\"學名\">學名</a>：<span title=\"拉丁語文本\"><span lang=\"la\">Dioscoreaceae</span></span>）為<a href=\"/wiki/%E5%8D%95%E5%AD%90%E5%8F%B6%E6%A4%8D%E7%89%A9\" class=\"mw-redirect\" title=\"單子葉植物\">單子葉植物</a><a href=\"/wiki/%E8%96%AF%E8%93%A3%E7%9B%AE\" title=\"薯蕷目\">薯蕷目</a>的一科，包括8-9<a href=\"/wiki/%E5%B1%9E\" title=\"屬\">屬</a>約750<a href=\"/wiki/%E7%A7%8D\" class=\"mw-redirect\" title=\"種\">種</a>。\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"形态\"><span id=\".E5.BD.A2.E6.80.81\"></span>形態</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%96%AF%E8%95%B7%E7%A7%91&amp;action=edit&amp;section=1\" title=\"編輯章節：形態\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>薯蕷科植物是多年生草質纏繞<a href=\"/wiki/%E8%97%A4%E6%9C%AC%E6%A4%8D%E7%89%A9\" title=\"藤本植物\">藤本植物</a>，有塊狀或根狀的地下<a href=\"/wiki/%E8%8C%8E\" title=\"莖\">莖</a>；<a href=\"/wiki/%E8%8C%8E\" title=\"莖\">莖</a>平滑或有刺；<a href=\"/wiki/%E5%8F%B6\" class=\"mw-redirect\" title=\"葉\">葉</a>互生或在上部對生，為單葉或掌狀複葉，中脈和側脈由葉基發出，有掌狀脈或網脈，這點同其他單子葉植物有別；<a href=\"/wiki/%E8%8A%B1\" title=\"花\">花</a>單性，雌雄異株，雌花也帶有幾枚退化的雄蕊，花被裂片6枚，2列，雄蕊6或3枚，子房下位，3室，每室有2個胚珠；有翅蒴果或漿果，有3個翅狀的棱，開裂為3個果瓣，種子一般都有翅。\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"分布\"><span id=\".E5.88.86.E5.B8.83\"></span>分布</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%96%AF%E8%95%B7%E7%A7%91&amp;action=edit&amp;section=2\" title=\"編輯章節：分布\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>薯蕷科植物廣泛分布在全世界的<a href=\"/wiki/%E7%83%AD%E5%B8%A6\" title=\"熱帶\">熱帶</a>和<a href=\"/wiki/%E4%BA%9A%E7%83%AD%E5%B8%A6\" title=\"亞熱帶\">亞熱帶</a>地區，<a href=\"/wiki/%E4%B8%AD%E5%9B%BD\" class=\"mw-redirect\" title=\"中國\">中國</a>只有2屬約80<a href=\"/wiki/%E7%A7%8D\" class=\"mw-redirect\" title=\"種\">種</a>，分布在<a href=\"/wiki/%E9%95%BF%E6%B1%9F\" title=\"長江\">長江</a>以南各地。\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"分类\"><span id=\".E5.88.86.E7.B1.BB\"></span>分類</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%96%AF%E8%95%B7%E7%A7%91&amp;action=edit&amp;section=3\" title=\"編輯章節：分類\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p><a href=\"/wiki/%E5%85%8B%E6%9C%97%E5%A5%8E%E6%96%AF%E7%89%B9%E5%88%86%E7%B1%BB%E6%B3%95\" title=\"克朗奎斯特分類法\">克朗奎斯特分類法</a>將本科列入<a href=\"/wiki/%E7%99%BE%E5%90%88%E7%9B%AE\" title=\"百合目\">百合目</a>，1998年的<a href=\"/wiki/APG_%E5%88%86%E7%B1%BB%E6%B3%95\" class=\"mw-redirect\" title=\"APG 分類法\">APG 分類法</a>根據<a href=\"/wiki/%E5%9F%BA%E5%9B%A0\" title=\"基因\">基因</a>分析將其單獨劃分為一個<a href=\"/wiki/%E7%9B%AE_(%E7%94%9F%E7%89%A9)\" title=\"目 (生物)\">目</a>，2003年經過改進的<a href=\"/wiki/APG_II_%E5%88%86%E7%B1%BB%E6%B3%95\" class=\"mw-redirect\" title=\"APG II 分類法\">APG II 分類法</a>將<a href=\"/wiki/%E8%92%9F%E8%92%BB%E8%96%AF%E7%A7%91\" class=\"mw-redirect\" title=\"蒟蒻薯科\">蒟蒻薯科</a>和毛柄花科合併到本科中。\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"内部分类\"><span id=\".E5.86.85.E9.83.A8.E5.88.86.E7.B1.BB\"></span>內部分類</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%96%AF%E8%95%B7%E7%A7%91&amp;action=edit&amp;section=4\" title=\"編輯章節：內部分類\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<dl><dt>1998年的薯蕷科 Dioscoreaceae</dt></dl>\n<ul><li><a href=\"/w/index.php?title=%E6%AF%94%E5%88%A9%E7%89%9B%E6%96%AF%E8%96%AF%E8%93%A3%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"庇里牛斯薯蕷屬（頁面不存在）\">庇里牛斯薯蕷屬</a> <i>Borderea</i></li>\n<li><a href=\"/wiki/%E8%96%AF%E8%93%A3%E5%B1%9E\" title=\"薯蕷屬\">薯蕷屬</a> <i>Dioscorea</i>（包括<a href=\"/wiki/%E5%B1%B1%E8%97%A5\" title=\"山藥\">山藥</a>、<a href=\"/wiki/%E9%A6%99%E8%8A%8B\" class=\"mw-disambig\" title=\"香芋\">香芋</a>等等，部份品種俗稱Yam）</li>\n<li><i><a href=\"/w/index.php?title=Epipetrum&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Epipetrum（頁面不存在）\">Epipetrum</a></i></li>\n<li><i><a href=\"/w/index.php?title=Rajania&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Rajania（頁面不存在）\">Rajania</a></i></li>\n<li><i><a href=\"/w/index.php?title=Stenomeris&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Stenomeris（頁面不存在）\">Stenomeris</a></i></li>\n<li><a href=\"/w/index.php?title=%E6%B5%86%E6%9E%9C%E8%96%AF%E8%93%A3%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"漿果薯蕷屬（頁面不存在）\">漿果薯蕷屬</a> <i>Tamus</i> （通常列入薯蕷屬中）</li></ul>\n<dl><dt>( 蒟蒻薯科 Taccaceae)</dt></dl>\n<ul><li><a href=\"/wiki/%E8%92%9F%E8%92%BB%E8%96%AF%E5%B1%9E\" title=\"蒟蒻薯屬\">蒟蒻薯屬</a> <i>Tacca</i></li></ul>\n<dl><dt>( 毛柄花科 Trichopodaceae)</dt></dl>\n<ul><li><i><a href=\"/w/index.php?title=Avetra&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Avetra（頁面不存在）\">Avetra</a></i></li>\n<li><a href=\"/w/index.php?title=%E6%AF%9B%E6%9F%84%E8%8A%B1%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"毛柄花屬（頁面不存在）\">毛柄花屬</a> <i>Trichopus</i></li></ul>\n<dl><dt>在GBIF上，薯蕷科有以下屬：</dt></dl>\n<ul style=\"taxonlist\"><li> <i><a href=\"/w/index.php?title=Asterocalyx&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Asterocalyx（頁面不存在）\">Asterocalyx</a></i> <small>Ettingshausen, 1888\n</small></li><li><a href=\"/wiki/%E8%96%AF%E8%93%A3%E5%B1%9E\" title=\"薯蕷屬\">薯蕷屬</a> <i>Dioscorea</i> <small>Plum. ex L.\n</small></li><li> <i><a href=\"/w/index.php?title=Dioscoreaecarpum&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Dioscoreaecarpum（頁面不存在）\">Dioscoreaecarpum</a></i> <small>G.Andreánszky, 1959\n</small></li><li> <i><a href=\"/w/index.php?title=Dioscoreophyllum&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Dioscoreophyllum（頁面不存在）\">Dioscoreophyllum</a></i> <small>Kraeusel &amp; Weyland, 1954\n</small></li><li> <i><a href=\"/w/index.php?title=Dioscorida&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Dioscorida（頁面不存在）\">Dioscorida</a></i> <small>St.-Lag., 1889\n</small></li><li> <i><a href=\"/w/index.php?title=Dioscoridia&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Dioscoridia（頁面不存在）\">Dioscoridia</a></i> <small>St.-Lag.\n</small></li><li> <i><a href=\"/w/index.php?title=Dioscorites&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Dioscorites（頁面不存在）\">Dioscorites</a></i> <small>G.Saporta, 1863\n</small></li><li> <i><a href=\"/w/index.php?title=Discorea&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Discorea（頁面不存在）\">Discorea</a></i> <small>Miq.\n</small></li><li> <i><a href=\"/w/index.php?title=Illigerastrum&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Illigerastrum（頁面不存在）\">Illigerastrum</a></i> <small>Prain &amp; Burkill, 1933\n</small></li><li> <i><a href=\"/w/index.php?title=Janraia&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Janraia（頁面不存在）\">Janraia</a></i> <small>Adans., 1763\n</small></li><li> <i><a href=\"/w/index.php?title=Prototamus&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Prototamus（頁面不存在）\">Prototamus</a></i> <small>M.Langeron, 1899\n</small></li><li><a href=\"/w/index.php?title=%E9%97%AD%E6%9E%9C%E8%96%AF%E8%93%A3%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"閉果薯蕷屬（頁面不存在）\">閉果薯蕷屬</a> <i>Raiania</i> <small>Scop.\n</small></li><li> <i><a href=\"/w/index.php?title=Rimilatericutis&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Rimilatericutis（頁面不存在）\">Rimilatericutis</a></i> <small>G.Roselt &amp; W.Schneider, 1969\n</small></li><li> <i><a href=\"/w/index.php?title=Steirexa&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Steirexa（頁面不存在）\">Steirexa</a></i> <small>Rafinesque, 1838\n</small></li><li><a href=\"/w/index.php?title=%E5%A4%9A%E5%AD%90%E8%96%AF%E8%93%A3%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"多子薯蕷屬（頁面不存在）\">多子薯蕷屬</a> <i>Stenomeris</i> <small>Planch.\n</small></li><li><a href=\"/wiki/%E8%92%9F%E8%92%BB%E8%96%AF%E5%B1%9E\" title=\"蒟蒻薯屬\">蒟蒻薯屬</a> <i>Tacca</i> <small>J.R.Forst. &amp; G.Forst.\n</small></li><li><a href=\"/w/index.php?title=%E5%9B%9B%E8%81%94%E7%9F%B3%E5%8D%97%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"四聯石南屬（頁面不存在）\">四聯石南屬</a> <i>Thamnus</i> <small>Link, 1822\n</small></li><li><a href=\"/wiki/%E9%AB%AE%E6%9F%84%E8%8A%B1%E5%B1%AC\" title=\"髮柄花屬\">髮柄花屬</a> <i>Trichopus</i> <small>Gaertn.，<a href=\"/w/index.php?title=%E6%AF%9B%E6%9F%84%E8%8A%B1%E5%B1%9E&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"毛柄花屬（頁面不存在）\">毛柄花屬</a>\n</small></li><li> <i><a href=\"/w/index.php?title=Varipilicutis&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Varipilicutis（頁面不存在）\">Varipilicutis</a></i> <small>W.Schneider, 1969\n</small></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"外部链接\"><span id=\".E5.A4.96.E9.83.A8.E9.93.BE.E6.8E.A5\"></span>外部連結</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E8%96%AF%E8%95%B7%E7%A7%91&amp;action=edit&amp;section=5\" title=\"編輯章節：外部連結\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li>在<a rel=\"nofollow\" class=\"external text\" href=\"http://delta-intkey.com/angio/\">L. Watson和M.J. Dallwitz (1992年)《有花植物分科》</a>（<a rel=\"nofollow\" class=\"external text\" href=\"//web.archive.org/web/20070103200438/http://delta-intkey.com/angio/\">頁面存檔備份<