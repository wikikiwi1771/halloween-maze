85%92%E5%BA%97%E9%9B%86%E5%9C%98&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"梅爾堡酒店集團（頁面不存在）\">梅爾堡酒店集團</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Maybourne_Hotel_Group\" class=\"extiw\" title=\"en:Maybourne Hotel Group\"><span lang=\"en\" dir=\"auto\">Maybourne Hotel Group</span></a></span><span class=\"ilh-paren\">）</span></span></span></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #ededed; color: var(--color-base);;\">技術細節</th></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">層數</th><td class=\"infobox-data\" style=\"\">6</td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #ededed; color: var(--color-base);;\">設計與建造</th></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">保護情況</th><td class=\"infobox-data\" style=\"\"><a href=\"https://www.wikidata.org/wiki/Q15700834\" class=\"extiw\" title=\"d:Q15700834\">第二級登錄建築</a><abbr title=\"此維基尚無此條目\">[*]</abbr></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #ededed; color: var(--color-base);;\">其他資訊</th></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">房間數</th><td class=\"infobox-data\" style=\"\">121</td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;;\">餐廳數</th><td class=\"infobox-data\" style=\"\">2</td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #ededed; color: var(--color-base);;\">網站</th></tr><tr><td colspan=\"2\" class=\"infobox-full-data\" style=\"\"><a rel=\"nofollow\" class=\"external text\" href=\"https://www.the-connaught.co.uk/\">www.the-connaught.co.uk</a></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background-color: #ededed; color: var(--color-base);;\">地圖</th></tr><tr><td colspan=\"2\" class=\"infobox-full-data\" style=\"\"><a class=\"mw-kartographer-map notheme noviewer mw-file-description mw-kartographer-container center\" style=\"min-width: 270px; min-height: 200px;\" data-mw-kartographer=\"mapframe\" data-style=\"osm-intl\" data-width=\"270\" data-height=\"200\" data-zoom=\"13\" data-overlays=\"[&quot;_5ccfd84424e5c1dd99c25668b553b32763bc02bb&quot;]\"><img class=\"mw-file-element\" src=\"https://maps.wikimedia.org/img/osm-intl,13,a,a,270x200.png?lang=zh&amp;domain=zh.wikipedia.org&amp;title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E9%85%92%E5%BA%97&amp;revid=90547616&amp;groups=_5ccfd84424e5c1dd99c25668b553b32763bc02bb&amp;parser=legacy\" width=\"270\" height=\"200\" decoding=\"async\" srcset=\"https://maps.wikimedia.org/img/osm-intl,13,a,a,270x200@2x.png?lang=zh&amp;domain=zh.wikipedia.org&amp;title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E9%85%92%E5%BA%97&amp;revid=90547616&amp;groups=_5ccfd84424e5c1dd99c25668b553b32763bc02bb&amp;parser=legacy 2x\" alt=\"地圖\" /></a><div class=\"infobox-caption\"></div></td></tr></tbody></table>\n<figure class=\"mw-default-size\" typeof=\"mw:File/Thumb\"><a href=\"/wiki/File:Connaught_3.JPG\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Connaught_3.JPG/250px-Connaught_3.JPG?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"188\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Connaught_3.JPG/500px-Connaught_3.JPG?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3264\" data-file-height=\"2448\" /></a><figcaption>2008年時的康諾特酒店</figcaption></figure>\n<p><b>康諾特酒店</b>（英語：<span lang=\"en\">The Connaught</span>）是一座五星級高檔酒店，位於<a href=\"/wiki/%E8%8B%B1%E5%9C%8B\" class=\"mw-redirect\" title=\"英國\">英國</a><a href=\"/wiki/%E5%80%AB%E6%95%A6\" class=\"mw-redirect\" title=\"倫敦\">倫敦</a><a href=\"/wiki/%E6%A2%85%E8%B4%B9%E5%B0%94\" title=\"梅費爾\">梅費爾</a>卡洛斯坊（Carlos Place）和<span class=\"ilh-all\" data-orig-title=\"芒特街 (倫敦)\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Mount Street, London\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E8%8A%92%E7%89%B9%E8%A1%97_(%E5%80%AB%E6%95%A6)&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"芒特街 (倫敦)（頁面不存在）\">芒特街</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Mount_Street,_London\" class=\"extiw\" title=\"en:Mount Street, London\"><span lang=\"en\" dir=\"auto\">Mount Street, London</span></a></span><span class=\"ilh-paren\">）</span></span></span>的路口<sup id=\"cite&#95;ref-frommerslondon2010&#95;1-0\" class=\"reference\"><a href=\"#cite_note-frommerslondon2010-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>。這座酒店由<span class=\"ilh-all\" data-orig-title=\"梅爾堡酒店集團\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Maybourne Hotel Group\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E6%A2%85%E7%88%BE%E5%A0%A1%E9%85%92%E5%BA%97%E9%9B%86%E5%9C%98&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"梅爾堡酒店集團（頁面不存在）\">梅爾堡酒店集團</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Maybourne_Hotel_Group\" class=\"extiw\" title=\"en:Maybourne Hotel Group\"><span lang=\"en\" dir=\"auto\">Maybourne Hotel Group</span></a></span><span class=\"ilh-paren\">）</span></span></span>所有並管理。\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"歷史\"><span id=\".E6.AD.B7.E5.8F.B2\"></span>歷史</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E9%85%92%E5%BA%97&amp;action=edit&amp;section=1\" title=\"編輯章節：歷史\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>這座酒店最初開業於1815年，當時名為薩克斯柯堡王子酒店（Prince of Saxe Coburg Hotel）<sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>，是亞歷山大·格里隆（Alexander Grillon）在梅費爾<a href=\"/wiki/%E9%9B%85%E5%AF%B6%E8%A1%97\" title=\"雅寶街\">雅寶街</a>開設酒店的分店之一。酒店最初是<span class=\"ilh-all\" data-orig-title=\"查爾斯街 (梅费尔)\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Charles Street, Mayfair\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E6%9F%A5%E7%88%BE%E6%96%AF%E8%A1%97_(%E6%A2%85%E8%B4%B9%E5%B0%94)&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"查爾斯街 (梅費爾)（頁面不存在）\">查爾斯街</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Charles_Street,_Mayfair\" class=\"extiw\" title=\"en:Charles Street, Mayfair\"><span lang=\"en\" dir=\"auto\">Charles Street, Mayfair</span></a></span><span class=\"ilh-paren\">）</span></span></span>上的一對<a href=\"/wiki/%E5%96%AC%E6%B2%BB%E6%99%82%E4%BB%A3%E5%BB%BA%E7%AF%89\" class=\"mw-redirect\" title=\"喬治時代建築\">喬治時代建築</a>，靠近<a href=\"/wiki/%E6%A0%BC%E7%BD%97%E5%A4%AB%E7%BA%B3%E5%B9%BF%E5%9C%BA\" title=\"格羅夫納廣場\">格羅夫納廣場</a>。<a href=\"/wiki/%E7%AC%AC%E4%B8%80%E4%BB%A3%E8%A5%BF%E6%95%8F%E5%85%AC%E7%88%B5%E4%BC%91%C2%B7%E6%A0%BC%E7%BE%85%E5%A4%AB%E7%B4%8D\" title=\"第一代西敏公爵休·格羅夫納\">第一代西敏公爵休·格羅夫納</a>決定重新開發這一地區，街道也隨之改為卡洛斯場。1892年，建築所有者Scorrier申請重建酒店，但工程在兩年後才開始，並拆除了舊有的建築。1897年，柯堡酒店重新開業。在第一次世界大戰期間的1917年，該酒店更名為康諾特酒店，以減少其德國色彩。酒店名稱取自於第一任<span class=\"ilh-all\" data-orig-title=\"康諾特公爵\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Duke of Connaught\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E5%85%AC%E7%88%B5&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"康諾特公爵（頁面不存在）\">康諾特公爵</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Duke_of_Connaught\" class=\"extiw\" title=\"en:Duke of Connaught\"><span lang=\"en\" dir=\"auto\">Duke of Connaught</span></a></span><span class=\"ilh-paren\">）</span></span></span><a href=\"/wiki/%E9%98%BF%E7%91%9F%E7%8E%8B%E5%AD%90_(%E5%BA%B7%E8%AF%BA%E7%89%B9%E5%92%8C%E6%96%AF%E7%89%B9%E6%8B%89%E6%A3%AE%E5%85%AC%E7%88%B5)\" class=\"mw-redirect\" title=\"阿瑟王子 (康諾特和斯特拉森公爵)\">亞瑟王子</a>，他也是<a href=\"/wiki/%E7%B6%AD%E5%A4%9A%E5%88%A9%E4%BA%9E%E5%A5%B3%E7%8E%8B\" class=\"mw-redirect\" title=\"維多利亞女王\">維多利亞女王</a>的第三個兒子。\n</p><p>1935年，一位年輕的瑞士酒店經營者魯道夫·理查（Rudolph Richard）成為康諾特酒店的總經理。1956年，康諾特酒店被薩伏伊集團收購。該集團也是<a href=\"/wiki/%E5%87%B1%E8%90%8A%E5%A5%87%E9%85%92%E5%BA%97\" title=\"凱萊奇酒店\">凱萊奇酒店</a>、<a href=\"/wiki/%E4%BC%AF%E5%85%8B%E5%88%A9%E9%85%92%E5%BA%97\" title=\"柏克萊酒店\">柏克萊酒店</a>和<a href=\"/wiki/%E8%96%A9%E4%BC%8F%E4%BC%8A%E9%A3%AF%E5%BA%97\" class=\"mw-redirect\" title=\"薩伏伊飯店\">薩伏伊飯店</a>的所有者。2005年，薩伏伊集團被一個愛爾蘭人組成的投資集團收購。該集團後出售了薩伏伊飯店和<a href=\"/wiki/%E8%90%A8%E6%B2%83%E4%BC%8A%E5%89%A7%E9%99%A2\" title=\"薩沃伊劇院\">薩沃伊劇院</a>，並更名為<span class=\"ilh-all\" data-orig-title=\"梅爾堡酒店集團\" data-lang-code=\"en\" data-lang-name=\"英语\" data-foreign-title=\"Maybourne Hotel Group\"><span class=\"ilh-page\"><a href=\"/w/index.php?title=%E6%A2%85%E7%88%BE%E5%A0%A1%E9%85%92%E5%BA%97%E9%9B%86%E5%9C%98&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"梅爾堡酒店集團（頁面不存在）\">梅爾堡酒店集團</a></span><span class=\"noprint ilh-comment\"><span class=\"ilh-paren\">（</span><span class=\"ilh-lang\">英語</span><span class=\"ilh-colon\">：</span><span class=\"ilh-link\"><a href=\"https://en.wikipedia.org/wiki/Maybourne_Hotel_Group\" class=\"extiw\" title=\"en:Maybourne Hotel Group\"><span lang=\"en\" dir=\"auto\">Maybourne Hotel Group</span></a></span><span class=\"ilh-paren\">）</span></span></span><sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>。\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"修復\"><span id=\".E4.BF.AE.E5.BE.A9\"></span>修復</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E9%85%92%E5%BA%97&amp;action=edit&amp;section=2\" title=\"編輯章節：修復\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>2007年3月，康諾特酒店暫時關閉，以進行一項耗資達7,000萬英鎊的修復計劃。2007年12月，酒店重新開業，但客房數量少於通常開業時期。翻新計劃持續至2008年康諾特酒吧開業為止<sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup>。酒店還設有一個游泳池和亞洲風格的水療。其它變化包括一個帶露台的新餐廳，以及由安德烈·科特斯（Andreas Cortes）管理的柯堡酒吧（Coburg Bar）。康諾特酒吧由調酒師阿格斯蒂諾·佩隆（Agostino Perrone）運營。該酒吧在2012年和2016年兩次獲得雞尾酒精神活力獎頒發的世界最佳雞尾酒酒吧獎，是世界唯一兩次贏得這一獎項的酒吧<sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup>。\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"著名客人\"><span id=\".E8.91.97.E5.90.8D.E5.AE.A2.E4.BA.BA\"></span>著名客人</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E9%85%92%E5%BA%97&amp;action=edit&amp;section=3\" title=\"編輯章節：著名客人\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>有眾多名人下榻過康諾特酒店，包括<a href=\"/wiki/%E7%88%B1%E5%BE%B7%E5%8D%8E%E4%B8%83%E4%B8%96\" title=\"愛德華七世\">愛德華七世</a>、<a href=\"/wiki/%E5%A4%8F%E7%88%BE%C2%B7%E6%88%B4%E9%AB%98%E6%A8%82\" title=\"夏勒·戴高樂\">夏勒·戴高樂</a>、美國海軍上將<a href=\"/wiki/%E6%9F%AF%E7%88%BE%E5%85%8B\" class=\"mw-redirect\" title=\"柯爾克\">柯爾克</a>、摩納哥王妃<a href=\"/wiki/%E8%91%9B%E9%BA%97%E7%B5%B2%C2%B7%E5%87%B1%E8%8E%89\" class=\"mw-redirect\" title=\"葛麗絲·凱莉\">葛麗絲·凱莉</a>、<a href=\"/wiki/%E5%A1%9E%E8%A5%BF%E7%88%BE%C2%B7%E6%AF%94%E9%A0%93\" title=\"塞西爾·比頓\">塞西爾·比頓</a>、<a href=\"/wiki/%E5%8A%A0%E9%87%8C%C2%B7%E6%A0%BC%E5%85%B0%E7%89%B9\" title=\"加里·格蘭特\">加里·格蘭特</a>、<a href=\"/wiki/%E5%A4%A7%E8%A1%9B%C2%B7%E5%B0%BC%E6%96%87\" title=\"大衛·尼文\">大衛·尼文</a>、<a href=\"/wiki/%E7%BE%85%E8%98%AD%C2%B7%E6%AF%94%E6%AD%8C\" title=\"羅蘭·比歌\">羅蘭·比歌</a>、<a href=\"/wiki/%E5%9F%83%E9%87%8C%E5%85%8B%C2%B7%E5%85%8B%E8%8E%B1%E6%99%AE%E9%A1%BF\" title=\"艾瑞克·克萊普頓\">艾瑞克·克萊普頓</a>、<a href=\"/wiki/%E6%9D%B0%E5%85%8B%C2%B7%E5%B0%BC%E7%A7%91%E5%B0%94%E6%A3%AE\" title=\"傑克·尼科爾森\">傑克·尼科爾森</a>和<a href=\"/wiki/%E6%8B%89%E5%B0%94%E5%A4%AB%C2%B7%E5%8A%B3%E4%BC%A6\" title=\"拉爾夫·勞倫\">拉爾夫·勞倫</a><sup id=\"cite&#95;ref-6\" class=\"reference\"><a href=\"#cite_note-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup>。演員<a href=\"/wiki/%E4%BA%9A%E5%8E%86%E5%85%8B%C2%B7%E5%90%89%E5%B0%BC%E6%96%AF\" title=\"亞歷·吉尼斯\">亞歷·吉尼斯</a>特別喜愛康諾特酒店。從1970年代至他2000年去世前夕，每當他在倫敦工作時，經常下榻在康諾特酒店。有一間套房經常由吉尼斯居住，他也經常和朋友在私人餐廳用餐<sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>。\n</p>\n<figure class=\"mw-default-size\" typeof=\"mw:File/Thumb\"><a href=\"/wiki/File:The_connaught_hotel_london_exterior_entrance.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/The_connaught_hotel_london_exterior_entrance.jpg/250px-The_connaught_hotel_london_exterior_entrance.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"167\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/The_connaught_hotel_london_exterior_entrance.jpg/500px-The_connaught_hotel_london_exterior_entrance.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"6483\" data-file-height=\"4322\" /></a><figcaption>2019年時的康諾特酒店入口</figcaption></figure>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"參考資料\"><span id=\".E5.8F.83.E8.80.83.E8.B3.87.E6.96.99\"></span>參考資料</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E5%BA%B7%E8%AB%BE%E7%89%B9%E9%85%92%E5%BA%97&amp;action=edit&amp;section=4\" title=\"編輯章節：參考資料\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r95320392\">.mw-parser-output .reflist{margin-bottom:0.5em;list-style-type:decimal}@media screen{.mw-parser-output .reflist{font-size:90%}}.mw-parser-output .reflist .references{font-size:100%;margin-bottom:0;list-style-type:inherit}.mw-parser-output .reflist-columns{margin-top:0.3em}.mw-parser-output .reflist-columns ol{margin-top:0}.mw-parser-output .reflist-columns li{page-break-inside:avoid;break-inside:avoid-column}.mw-parser-output .reflist-upper-alpha{list-style-type:upper-alpha}.mw-parser-output .reflist-upper-roman{list-style-type:upper-roman}.mw-parser-output .reflist-lower-alpha{list-style-type:lower-alpha}.mw-parser-output .reflist-lower-greek{list-style-type:lower-greek}.mw-parser-output .reflist-lower-roman{list-style-type:lower-roman}</style><div class=\"reflist\"><ol class=\"references\">\n<li id=\"cite&#95;note-frommerslondon2010-1\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-frommerslondon2010_1-0\">^</a></b></span> <span class=\"reference-text\">Darwin Porter, Danforth Prince, <i>London 2010</i>, <a href=\"/w/index.php?title=Frommer%27s&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Frommer&#39;s（頁面不存在）\">Frommer's</a>, New York City: John Wiley &amp; Sons, 2011, p. 140 <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://books.google.co.uk/books?id=LWo1ZcnyE0YC&amp;pg