n_edit-ltr.svg/40px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"min-width: 4em;max-width:6em;;\">所屬實體</th><td class=\"infobox-data\" style=\"\"><span><span><a href=\"/wiki/%E6%80%9D%E6%83%B3\" title=\"思想\">思維</a></span>、​<span>心理學術語集</span></span>&#160;<span class=\"mw-valign-baseline noviewer skin-invert\" typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q131841#P361\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/20px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/40px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"min-width: 4em;max-width:6em;;\">原因</th><td class=\"infobox-data\" style=\"\"><span><span>構思</span></span>&#160;<span class=\"mw-valign-baseline noviewer skin-invert\" typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q131841#P828\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/20px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/40px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"min-width: 4em;max-width:6em;;\">主題標籤</th><td class=\"infobox-data\" style=\"\"><span><span>idea</span></span>&#160;<span class=\"mw-valign-baseline noviewer skin-invert\" typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q131841#P2572\" title=\"編輯\"><img alt=\"編輯\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/20px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr.svg/40px-OOjs_UI_icon_edit-ltr.svg.png?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"20\" data-file-height=\"20\" /></a></span></td></tr></tbody></table>\n<figure typeof=\"mw:File/Thumb\"><a href=\"/wiki/File:Otto_Merkt_von_Akos.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Otto_Merkt_von_Akos.jpg/250px-Otto_Merkt_von_Akos.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"200\" height=\"296\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/f/fe/Otto_Merkt_von_Akos.jpg?utm_source=zh.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\" data-file-width=\"406\" data-file-height=\"600\" /></a><figcaption></figcaption></figure>\n<p><b>構想</b>（英語：<span lang=\"en\">idea</span>，又稱<b>構思</b>、<b>點子</b>）是<a href=\"/wiki/%E6%80%9D%E8%80%83\" class=\"mw-redirect\" title=\"思考\">思考</a>的產物，包括對事物的<a href=\"/wiki/%E6%B4%9E%E5%AF%9F%E5%8A%9B\" title=\"洞察力\">見解</a>和<a href=\"/wiki/%E6%84%8F%E8%A7%81\" title=\"意見\">意見</a>，以及<a href=\"/wiki/%E8%A7%A3%E6%B1%BA%E5%95%8F%E9%A1%8C\" class=\"mw-redirect\" title=\"解決問題\">解決問題</a>的方法。構想作為抽象的觀點外，在<a href=\"/wiki/%E5%93%B2%E5%AD%B8\" class=\"mw-redirect\" title=\"哲學\">哲學</a>中亦為某些<a href=\"/wiki/%E5%AE%A2%E9%AB%94\" title=\"客體\">客體</a><a href=\"/wiki/%E5%BF%83%E6%99%BA%E8%A1%A8%E5%BE%B5\" title=\"心智表徵\">心智表徵</a>的具象。許多哲學家認為構想是存在最基要的<a href=\"/wiki/%E7%AF%84%E7%96%87_(%E5%93%B2%E5%AD%B8)\" class=\"mw-redirect\" title=\"範疇 (哲學)\">本體論範疇之一</a>；得以<a href=\"/wiki/%E5%89%B5%E9%80%A0%E5%8A%9B\" title=\"創造力\">創造</a>並<a href=\"/wiki/%E7%90%86%E8%A7%A3\" title=\"理解\">理解</a>構想意義的能力被視為<a href=\"/wiki/%E4%BA%BA%E9%A1%9E\" class=\"mw-redirect\" title=\"人類\">人類</a>必要且決斷的特徵。\n</p><p><b>點子</b>是創意的<a href=\"/wiki/%E9%87%8F%E5%8C%96\" class=\"mw-disambig\" title=\"量化\">量化</a>，使創意內容成為一個個可數的點子，是一個簡單的日常<a href=\"/wiki/%E5%8F%A3%E8%AA%9E\" class=\"mw-redirect\" title=\"口語\">口語</a>字彙。例如：「關於情人節我要送她的禮物，你有沒有什麼點子？」是形容詢問有沒有創意的想法。又例如：「他這小子滿腦筋都是鬼點子！」是形容一個人的想法或創意想法很多，有與眾不同的意思。點子常與想法、創意、理念混淆，在西方學者對人類的<a href=\"/wiki/%E5%89%B5%E9%80%A0%E5%8A%9B\" title=\"創造力\">創造力</a>的定義研究論述也相當廣泛。其中，腦中發揮創造力的結果就是要產生點子。美國<a href=\"/wiki/%E7%B4%90%E7%B4%84%E5%A4%A7%E5%AD%B8\" class=\"mw-redirect\" title=\"紐約大學\">紐約大學</a><a href=\"/wiki/%E5%8F%B2%E7%99%BB%E5%95%86%E5%AD%B8%E9%99%A2\" title=\"史登商學院\">史登商學院</a><span title=\"英語文本\"><span lang=\"en\">Melissa A. Schilling</span></span>教授認為<a href=\"/wiki/%E5%89%B5%E6%96%B0\" title=\"創新\">創新</a>始於新點子的產生，產生新奇有用的點子的能力就稱為<a href=\"/wiki/%E5%89%B5%E9%80%A0%E5%8A%9B\" title=\"創造力\">創造力</a>。\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"詞源\"><span id=\".E8.A9.9E.E6.BA.90\"></span>詞源</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E6%9E%84%E6%83%B3&amp;action=edit&amp;section=1\" title=\"編輯章節：詞源\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>術語 idea 源自<a href=\"/wiki/%E5%8F%A4%E5%B8%8C%E8%85%8A%E8%AF%AD\" title=\"古希臘語\">古希臘語</a> ἰδέα（<i>idéa</i>, 「notion, pattern」）「看法、想法；模式、形式」之義，其又源自 εἴδω（<i>eídō</i>, 「I see」）「看到、知道」之義。因此用觀念來翻譯較爲合適。紅背包，紅色蘋果，紅色的血，抽象出來的一個紅就是觀念<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>。柏拉圖的<a href=\"/wiki/%E7%90%86%E5%9E%8B%E8%AB%96\" class=\"mw-redirect\" title=\"理型論\">觀念論</a>標志著<a href=\"/wiki/%E5%B8%8C%E8%87%98%E5%93%B2%E5%AD%B8\" class=\"mw-redirect\" title=\"希臘哲學\">希臘哲學</a>乃至<a href=\"/wiki/%E8%A5%BF%E6%96%B9%E5%93%B2%E5%AD%A6\" title=\"西方哲學\">西方哲學</a><a href=\"/wiki/%E6%8A%BD%E8%B1%A1%E5%8C%96\" title=\"抽象化\">抽象化</a>的開端。而觀念一詞經過了漫長的歲月有了龐大而豐富的含義。\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"不同解釋\"><span id=\".E4.B8.8D.E5.90.8C.E8.A7.A3.E9.87.8B\"></span>不同解釋</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E6%9E%84%E6%83%B3&amp;action=edit&amp;section=2\" title=\"編輯章節：不同解釋\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li>牛津辭典上的中譯解釋是關於一個可能的行動方針的想法或建議（理念）的目標或目的。</li>\n<li>美國廣告大師<a href=\"/wiki/%E8%A9%B9%E5%A7%86%E6%96%AF%C2%B7%E9%9F%8B%E4%BC%AF%C2%B7%E6%8F%9A\" class=\"mw-redirect\" title=\"詹姆斯·韋伯·揚\">詹姆斯·韋伯·揚</a>楊傑美認為點子不過就是舊的元素的新組合罷了。</li>\n<li>點子就是創造行為（<span title=\"英語文本\"><span lang=\"en\">idea</span></span>=<span title=\"英語文本\"><span lang=\"en\">CB</span></span>（<span title=\"英語文本\"><span lang=\"en\">Creativity Behavior</span></span>）），是想像力（<span title=\"英語文本\"><span lang=\"en\">imagination</span></span>）、資訊（<span title=\"英語文本\"><span lang=\"en\">data</span></span>）、評鑑（<span title=\"英語文本\"><span lang=\"en\">evaluation</span></span>）及實踐（<span title=\"英語文本\"><span lang=\"en\">action</span></span>）四種因素的交互作用（陳龍安，1984）。</li>\n<li>BusinessDictionary.com商業字典網站針對點子在商務英語中的用法提出了三種不同的意義：暨點子是在頭腦裡引起想法或彙集；想法通常引起與意向，但是可能無心地也被創造；想法經常形成在激發靈感會議期間或通過討論。</li>\n<li><span title=\"英語文本\"><span lang=\"en\">Michaels Michalko</span></span>（1994）認為俗稱idea從字義拆解來看。</li>\n<li>日本廣告大師加藤昌治Kato MasaHaru認為點子是企劃的根源，和自由奔放的發想等。</li>\n<li><a href=\"/wiki/%E7%BE%85%E4%BC%AF%E7%89%B9%C2%B7%E4%BD%9B%E6%B4%9B%E6%96%AF%E7%89%B9\" title=\"羅伯特·佛洛斯特\">羅伯特·佛洛斯特</a>認為點子就是把兩個不相關的東西湊在一起。</li>\n<li>美國導演<a href=\"/wiki/%E5%A4%A7%E5%8D%AB%C2%B7%E6%9E%97%E5%A5%87\" title=\"大衛·林奇\">大衛·林奇</a>認為點子就是思緒。</li>\n<li>台灣作家<a href=\"/w/index.php?title=%E9%83%AD%E6%B3%B0_(%E4%BD%9C%E5%AE%B6)&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"郭泰 (作家)（頁面不存在）\">郭泰</a>（1911）認為點子就是創造新意。</li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"參見\"><span id=\".E5.8F.83.E8.A6.8B\"></span>參見</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E6%9E%84%E6%83%B3&amp;action=edit&amp;section=3\" title=\"編輯章節：參見\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/%E6%80%9D%E6%83%B3\" title=\"思想\">思想</a></li>\n<li><a href=\"/wiki/%E6%A6%82%E5%BF%B5\" title=\"概念\">概念</a></li>\n<li><a href=\"/wiki/%E9%9D%88%E6%84%9F\" title=\"靈感\">靈感</a></li>\n<li><a href=\"/wiki/%E5%89%B5%E9%80%A0%E5%8A%9B\" title=\"創造力\">創造力</a></li>\n<li><a href=\"/wiki/%E6%84%8F%E8%AD%98%E5%BD%A2%E6%85%8B\" title=\"意識形態\">意識形態</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"参考\"><span id=\".E5.8F.82.E8.80.83\"></span>參考</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%E6%9E%84%E6%83%B3&amp;action=edit&amp;section=4\" title=\"編輯章節：參考\"><span>編輯</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r95310437\">.mw-parser-output .reflist{margin-bottom:0.5em;list-style-type:decimal}@media screen{.mw-parser-output .reflist{font-size:90%}}.mw-parser-output .reflist .references{font-size:100%;margin-bottom:0;list-style-type:inherit}.mw-parser-output .reflist-columns{margin-top:0.3em}.mw-parser-output .reflist-columns ol{margin-top:0}.mw-parser-output .reflist-columns li{page-break-inside:avoid;break-inside:avoid-column}.mw-parser-output .reflist-